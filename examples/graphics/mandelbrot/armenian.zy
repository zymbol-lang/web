// @skip-parity: կտավը պահանջում է իսկական տերմինալ CLI-ի տակ և կտավի շերտ
// @skip-parity: դիտարկիչում, ուստի խողովակով աշխատեցնելը համեմատելու բան չի թողնում։
// ============================================================
// mandelbrot — Մանդելբրոտի բազմությունը, գծված տերմինալի կտավին։
// Անունները հայերեն։ Նշանները միշտ մնում են նշան։
//
// Ամեն ինչ որոշում է մեկ թիվ՝ `n`, թե ուղեծիրը քանի քայլ է դիմանում
// փախչելուց առաջ։ Հենց նա է ընտրում տառը, և հենց նա է ընտրում
// գույնը. ուստի պատկերը չի կարող հակասել ինքն իրեն։ `n = 0` նշանակում
// է, որ երբեք չի փախել — հենց դա է բազմությունն ինքը, լիքը գծված։
//
//   >>|  բացում է կտավը   >>!  ջնջում է   >>?  չափում է
//   >>~  գրում է մեկ վանդակ, մեկ տողում, մեկ սյունակում, մեկ գույնով
//   <<|  սպասում է մեկ ստեղնի
//
// Երկու խնայողություն, և երկուսն էլ երևում են պատկերում, ոչ թե
// չափման մեջ. քառակուսիները մի քայլից մյուսը տեղափոխվում են՝ նորից
// հաշվելու փոխարեն, իսկ բազմությունը հայելվում է իրական առանցքի
// շուրջ, ուստի փախչում է միայն վերին կեսը։ Երկուսը միասին վճարում
// են այն սրության գինը, որ պահանջում է մանրամասնը։
// ============================================================

// Բազմությունից դուրս՝ գունատից լիքը, մուգ կանաչից պայծառ։
թեքություն = " .:-=+*#%"
գույներ    = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Քայլերը, որոնց ուղեծիրը դիմացավ փախչելուց առաջ. 0, եթե երբեք չփախավ։
// zr2-ը և zi2-ը տանում են հետը, ուստի ամեն քայլ արժե չորս արտադրյալ, ոչ թե վեց։
փախուստ(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (բարձրություն, լայնություն) = >>?
    տողեր    = բարձրություն - 2
    սյունակներ = լայնություն  - 1

    // Վանդակն իր լայնությունից մոտ 2.5 անգամ բարձր է. ուղղահայաց
    // տարածքը դրանով է մասշտաբվում, որ բազմությունը կլոր դուրս գա։
    լայնքը  = 2.7
    բարձրքը = տողեր * լայնքը * 2.5 / սյունակներ
    միջին   = տողեր / 2 + 1

    @ y:1..միջին {
        հայելի = տողեր + 1 - y
        @ x:1..սյունակներ {
            cr = (x - 1) * լայնքը  / սյունակներ - 2.1
            ci = (y - 1) * բարձրքը / տողեր      - բարձրքը / 2.0
            n  = փախուստ(cr, ci)
            նշան = "@"
            գույն = 231
            ? n <> 0 {
                քայլ = n / 4 + 1
                ? քայլ > 9 { քայլ = 9 }
                նշան  = թեքություն[քայլ]
                գույն = գույներ[քայլ]
            }
            >>~ (y, x, 0, գույն) > նշան
            ? հայելի > միջին { >>~ (հայելի, x, 0, գույն) > նշան }
        }
    }

    >>~ (բարձրություն, 2, 0, 244) > "դուրս գալու համար սեղմեք ցանկացած ստեղն"
    <<| _ստեղն
}
