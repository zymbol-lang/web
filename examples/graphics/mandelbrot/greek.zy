// @skip-parity: ο καμβάς χρειάζεται πραγματικό τερματικό κάτω από το CLI και ένα
// @skip-parity: στρώμα καμβά στον φυλλομετρητή, οπότε μια εκτέλεση μέσα από
// @skip-parity: σωλήνωση δεν έχει τίποτα να συγκρίνει.
// ============================================================
// mandelbrot — το σύνολο Mandelbrot, σχεδιασμένο στον καμβά.
// Ονόματα στα ελληνικά. Τα σημάδια μένουν πάντα σημάδια.
//
// Ένας αριθμός τα κρίνει όλα: `αντοχή`, πόσα βήματα αντέχει η τροχιά
// πριν ξεφύγει. Αυτός διαλέγει το ψηφίο και αυτός διαλέγει το
// χρώμα, ώστε η εικόνα να μην μπορεί να αντιφάσκει. `αντοχή = 0`
// σημαίνει ότι δεν ξέφυγε ποτέ — αυτό είναι το σύνολο, γεμάτο.
//
//   >>|  ανοίγει τον καμβά   >>!  τον σβήνει   >>?  τον μετρά
//   >>~  γράφει ένα κελί, σε μια γραμμή, μια στήλη, σε ένα χρώμα
//   <<|  περιμένει ένα πλήκτρο
//
// Δύο οικονομίες, και οι δύο φαίνονται στην εικόνα και όχι σε
// μέτρηση: τα τετράγωνα μεταφέρονται από βήμα σε βήμα αντί να
// ξαναϋπολογίζονται, και το σύνολο κατοπτρίζεται γύρω από τον
// πραγματικό άξονα, ώστε να ξεφεύγει μόνο το πάνω μισό. Μαζί
// πληρώνουν την ανάλυση που ζητά η λεπτομέρεια.
// ============================================================

// Έξω από το σύνολο: από αχνό σε γεμάτο, από σκούρο πράσινο σε λαμπερό.
κλίμακα = " .:-=+*#%"
χρώματα = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Βήματα που αντέχει πριν ξεφύγει η τροχιά· 0 αν δεν ξεφύγει ποτέ.
// Τα τροχιά_πραγμ2 και τροχιά_φαντ2 μεταφέρονται, ώστε κάθε βήμα να κοστίζει τέσσερα γινόμενα, όχι έξι.
διαφυγή(σημείο_πραγμ, σημείο_φαντ) {
    τροχιά_πραγμ  = 0.0
    τροχιά_φαντ   = 0.0
    τροχιά_πραγμ2 = 0.0
    τροχιά_φαντ2  = 0.0
    @ γύρος:1..36 {
        ? τροχιά_πραγμ2 + τροχιά_φαντ2 > 4.0 { <~ γύρος }
        τροχιά_φαντ   = 2.0 * τροχιά_πραγμ * τροχιά_φαντ + σημείο_φαντ
        τροχιά_πραγμ  = τροχιά_πραγμ2 - τροχιά_φαντ2 + σημείο_πραγμ
        τροχιά_πραγμ2 = τροχιά_πραγμ * τροχιά_πραγμ
        τροχιά_φαντ2  = τροχιά_φαντ * τροχιά_φαντ
    }
    <~ 0
}

>>| {
    >>!
    (ψηλό, φαρδύ) = >>?
    γραμμές = ψηλό  - 2
    στήλες  = φαρδύ - 1

    // Ένα κελί είναι ~2,5 φορές ψηλότερο απ' όσο φαρδύ· το κάθετο
    // άνοιγμα κλιμακώνεται μ' αυτό, ώστε το σύνολο να βγει στρογγυλό.
    πλάτος = 2.7
    ύψος   = γραμμές * πλάτος * 2.5 / στήλες
    μέσο   = γραμμές / 2 + 1

    @ γραμμή:1..μέσο {
        καθρέφτης = γραμμές + 1 - γραμμή
        @ στήλη:1..στήλες {
            σημείο_πραγμ = (στήλη  - 1) * πλάτος / στήλες  - 2.1
            σημείο_φαντ  = (γραμμή - 1) * ύψος   / γραμμές - ύψος / 2.0
            αντοχή       = διαφυγή(σημείο_πραγμ, σημείο_φαντ)
            σημάδι       = "@"
            χρώμα        = 231
            ? αντοχή <> 0 {
                βήμα = αντοχή / 4 + 1
                ? βήμα > 9 { βήμα = 9 }
                σημάδι = κλίμακα[βήμα]
                χρώμα  = χρώματα[βήμα]
            }
            >>~ (γραμμή, στήλη, 0, χρώμα) > σημάδι
            ? καθρέφτης > μέσο { >>~ (καθρέφτης, στήλη, 0, χρώμα) > σημάδι }
        }
    }

    >>~ (ψηλό, 2, 0, 244) > "οποιοδήποτε πλήκτρο για έξοδο"
    <<| _πλήκτρο
}
