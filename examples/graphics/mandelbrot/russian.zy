// @skip-parity: холсту нужен настоящий терминал под CLI и слой холста в
// @skip-parity: браузере, поэтому прогон через конвейер сравнивать не с чем.
// ============================================================
// mandelbrot — множество Мандельброта, нарисованное на холсте терминала.
// Имена по-русски. Знаки всегда остаются знаками.
//
// Всё решает одно число: `n`, сколько шагов орбита выдерживает,
// прежде чем убежать. Оно выбирает начертание и оно выбирает
// цвет, поэтому рисунок не может себе противоречить. `n = 0`
// значит, что она не убежала никогда — это и есть множество,
// нарисованное плотно.
//
//   >>|  открывает холст   >>!  очищает его   >>?  измеряет его
//   >>~  пишет одну клетку, в строке, в столбце, одним цветом
//   <<|  ждёт клавишу
//
// Две экономии, и обе видны на рисунке, а не в замере: квадраты
// переносятся с шага на шаг вместо пересчёта, а множество
// отражается относительно действительной оси, так что убегает
// только верхняя половина. Вместе они оплачивают то разрешение,
// которого требует деталь.
// ============================================================

// Вне множества: от бледного к плотному, от тёмно-зелёного к яркому.
шкала = " .:-=+*#%"
цвета = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Шаги, выдержанные до того, как орбита убежит; 0, если она не убегает.
// zr2 и zi2 переносятся, поэтому каждый шаг стоит четыре умножения, а не шесть.
побег(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (высоко, широко) = >>?
    строки  = высоко - 2
    столбцы = широко - 1

    // Клетка примерно в 2,5 раза выше, чем шире; вертикальный
    // размах на это масштабируется, чтобы множество вышло круглым.
    ширина  = 2.7
    высота  = строки * ширина * 2.5 / столбцы
    середина = строки / 2 + 1

    @ y:1..середина {
        зеркало = строки + 1 - y
        @ x:1..столбцы {
            cr = (x - 1) * ширина / столбцы - 2.1
            ci = (y - 1) * высота / строки  - высота / 2.0
            n  = побег(cr, ci)
            знак = "@"
            цвет = 231
            ? n <> 0 {
                шаг = n / 4 + 1
                ? шаг > 9 { шаг = 9 }
                знак = шкала[шаг]
                цвет = цвета[шаг]
            }
            >>~ (y, x, 0, цвет) > знак
            ? зеркало > середина { >>~ (зеркало, x, 0, цвет) > знак }
        }
    }

    >>~ (высоко, 2, 0, 244) > "любая клавиша для выхода"
    <<| _клавиша
}
