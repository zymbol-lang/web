// @skip-parity: ikhanvasi lifuna itheminali yokwenene phantsi kwe-CLI kunye
// @skip-parity: nomaleko wekhanvasi kwisikhangeli, ngoko ukusebenza ngombhobho
// @skip-parity: akunanto inokuthelekiswa.
// ============================================================
// mandelbrot — ingqokelela kaMandelbrot, izotywe kwikhanvasi yetheminali.
// Amagama ngesiXhosa. Iimpawu zihlala ziziimpawu.
//
// Yonke into igqitywa linani elinye: `n`, ukuba umjikelo unyamezela
// amanyathelo amangaphi ngaphambi kokuba ubaleke. Nguwo okhetha
// unobumba, kwaye nguwo okhetha umbala; ngoko umfanekiso awunakuziphika.
// `n = 0` kuthetha ukuba awuzange ubaleke — leyo yingqokelela ngokwayo,
// izotywe izele.
//
//   >>|  livula ikhanvasi   >>!  liyacima   >>?  liyalinganisa
//   >>~  libhala ibhokisi elinye, kumgca omnye, entsika enye, ngombala omnye
//   <<|  lilinda isitshixo esinye
//
// Ukonga okubini, kwaye kokubini kubonakala emfanekisweni kungabonakali
// kumlinganiso: izikwere zithwalwa ukusuka kwinyathelo elinye ukuya
// kwelilandelayo endaweni yokuba zibalwe kwakhona, kwaye ingqokelela
// ibonakaliswa esipilini ijikeleza i-axis yokwenene, ngoko yisiqingatha
// esingasentla kuphela esibalekayo. Kokubini kunye kuhlawula ubungqingqwa
// obufunwa yinkcazelo.
// ============================================================

// Ngaphandle kwengqokelela: ukusuka kokuphuphileyo ukuya kokuzeleyo, ukusuka kokuluhlaza okumnyama ukuya kokukhanyayo.
umthambeka = " .:-=+*#%"
imibala    = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Amanyathelo anyamezelweyo ngaphambi kokuba umjikelo ubaleke; 0 ukuba akuzange.
// I-zr2 ne-zi2 ziyathwalwa, ngoko inyathelo ngalinye libiza imveliso ezine, hayi ezintandathu.
baleka(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (ubude, ububanzi) = >>?
    imigca   = ubude    - 2
    iintsika = ububanzi - 1

    // Ibhokisi lide malunga namaxesha ama-2.5 kunobubanzi balo; ubude
    // obumileyo bulinganiswa ngoko ukuze ingqokelela iphume isisangqa.
    ububanziBendawo = 2.7
    ubudeBendawo    = imigca * ububanziBendawo * 2.5 / iintsika
    phakathi        = imigca / 2 + 1

    @ y:1..phakathi {
        isipili = imigca + 1 - y
        @ x:1..iintsika {
            cr = (x - 1) * ububanziBendawo / iintsika - 2.1
            ci = (y - 1) * ubudeBendawo    / imigca   - ubudeBendawo / 2.0
            n  = baleka(cr, ci)
            uphawu = "@"
            umbala = 231
            ? n <> 0 {
                inyathelo = n / 4 + 1
                ? inyathelo > 9 { inyathelo = 9 }
                uphawu = umthambeka[inyathelo]
                umbala = imibala[inyathelo]
            }
            >>~ (y, x, 0, umbala) > uphawu
            ? isipili > phakathi { >>~ (isipili, x, 0, umbala) > uphawu }
        }
    }

    >>~ (ubude, 2, 0, 244) > "cofa nasiphi na isitshixo ukuze uphume"
    <<| _isitshixo
}
