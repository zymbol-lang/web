// @skip-parity: o lenzo precisa dun terminal de verdade baixo a CLI e dunha
// @skip-parity: capa de lenzo no navegador, así que unha execución por tubo non
// @skip-parity: ten con que compararse.
// ============================================================
// mandelbrot — o conxunto de Mandelbrot, debuxado no lenzo do terminal.
// Nomes en galego. Os signos son sempre signos.
//
// Un só número decide todo: `n`, cantos pasos aguanta a órbita
// antes de fuxir. El escolle o glifo e el escolle o ton, así que o
// debuxo non se pode contradicir. `n = 0` quere dicir que non
// fuxiu nunca — iso é o conxunto, debuxado cheo.
//
//   >>|  abre o lenzo   >>!  bórrao   >>?  mídeo
//   >>~  escribe unha cela, nunha fila, nunha columna, nun ton
//   <<|  agarda por unha tecla
//
// Dúas economías, e as dúas vense no debuxo e non nunha medición:
// os cadrados lévanse dun paso ao seguinte no canto de recalcularse,
// e o conxunto espéllase arredor do eixo real, así que só a metade
// de arriba chega a fuxir. Xuntas pagan a resolución que o detalle
// pide.
// ============================================================

// Fóra do conxunto: de tenue a cheo, de verde escuro a brillante.
rampa = " .:-=+*#%"
tons  = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Pasos aguantados antes de que a órbita fuxa; 0 se non fuxe nunca.
// zr2 e zi2 lévanse, así que cada paso custa catro produtos, non seis.
fuga(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (alto, ancho) = >>?
    filas    = alto  - 2
    columnas = ancho - 1

    // Unha cela é ~2,5 veces máis alta que ancha; a extensión
    // vertical escálase con iso para que o conxunto saia redondo.
    largura = 2.7
    altura  = filas * largura * 2.5 / columnas
    medio   = filas / 2 + 1

    @ y:1..medio {
        espello = filas + 1 - y
        @ x:1..columnas {
            cr = (x - 1) * largura / columnas - 2.1
            ci = (y - 1) * altura  / filas    - altura / 2.0
            n  = fuga(cr, ci)
            marca = "@"
            ton   = 231
            ? n <> 0 {
                paso = n / 4 + 1
                ? paso > 9 { paso = 9 }
                marca = rampa[paso]
                ton   = tons[paso]
            }
            >>~ (y, x, 0, ton) > marca
            ? espello > medio { >>~ (espello, x, 0, ton) > marca }
        }
    }

    >>~ (alto, 2, 0, 244) > "calquera tecla para saír"
    <<| _tecla
}
