// @skip-parity: 🖼 canvas needs a real terminal under the CLI and a canvas layer in
// @skip-parity: the browser, so a run through a pipe has nothing to compare.
// ============================================================
// mandelbrot — 🌀 the Mandelbrot set, drawn on a terminal canvas.
// 🏷 The names are emoji. The marks are still marks.
//
// 1️⃣ number decides everything: `n`, how many steps the orbit survives
// before it runs away. It picks the glyph 🪜 and it picks the colour 🎨,
// so the picture cannot contradict itself. `n = 0` means it never ran —
// that is the set itself, drawn full.
//
//   >>|  opens 🖼   >>!  clears   >>?  measures
//   >>~  writes one 🔲, on one ➡, one ⬇, in one 🎨
//   <<|  waits for one 🔑
//
// 2️⃣ savings, and both show in the picture rather than in a measurement:
// the squares are carried from one 👣 to the next instead of recomputed,
// and the set is mirrored 🪞 about the real axis, so only the top half
// runs. Together they pay for the sharpness the detail asks for.
// ============================================================

// Outside the set: faint to solid, dark green to bright.
🪜 = " .:-=+*#%"
🌈 = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Steps survived before the orbit runs away; 0 if it never does.
// zr2 and zi2 are carried, so each 👣 costs four products, not six.
🏃(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (📏, 📐) = >>?
    ➡ = 📏 - 2
    ⬇ = 📐 - 1

    // A 🔲 is ~2.5x taller than wide; the vertical span is scaled by that
    // so the set comes out round.
    🗺📐 = 2.7
    🗺📏 = ➡ * 🗺📐 * 2.5 / ⬇
    🎯   = ➡ / 2 + 1

    @ y:1..🎯 {
        🪞 = ➡ + 1 - y
        @ x:1..⬇ {
            cr = (x - 1) * 🗺📐 / ⬇ - 2.1
            ci = (y - 1) * 🗺📏 / ➡ - 🗺📏 / 2.0
            n  = 🏃(cr, ci)
            ✏ = "@"
            🎨 = 231
            ? n <> 0 {
                👣 = n / 4 + 1
                ? 👣 > 9 { 👣 = 9 }
                ✏ = 🪜[👣]
                🎨 = 🌈[👣]
            }
            >>~ (y, x, 0, 🎨) > ✏
            ? 🪞 > 🎯 { >>~ (🪞, x, 0, 🎨) > ✏ }
        }
    }

    >>~ (📏, 2, 0, 244) > "🔑 any key to leave"
    <<| _🔑
}
