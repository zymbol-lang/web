// @skip-parity: تحتاج اللوحة إلى طرفية حقيقية تحت واجهة الأوامر وإلى طبقة لوحة في
// @skip-parity: المتصفح، فالتشغيل عبر أنبوب لا يترك شيئًا يُقارَن.
// ============================================================
// mandelbrot — مجموعة ماندلبرو، مرسومة على لوحة الطرفية.
// الأسماء بالعربية. والعلامات تبقى علامات دائمًا.
//
// عدد واحد يقرر كل شيء: ‏`صمود`‏، كم خطوة يحتمل المدار قبل أن يهرب.
// هو من يختار الحرف، وهو من يختار اللون، فلا تستطيع الصورة أن
// تناقض نفسها. ‏`صمود = ٠`‏ يعني أنه لم يهرب قط — تلك هي المجموعة
// نفسها، مرسومة ممتلئة.
//
//   >>|  تفتح اللوحة   >>!  تمسح   >>?  تقيس
//   >>~  تكتب مربعًا واحدًا، في صف واحد، عمود واحد، بلون واحد
//   <<|  تنتظر مفتاحًا واحدًا
//
// توفيران، وكلاهما يُرى في الصورة لا في قياس: تُحمَل المربعات من
// خطوة إلى التي تليها بدل إعادة حسابها، وتُعكَس المجموعة حول المحور
// الحقيقي، فلا يهرب إلا نصفها الأعلى. وهما معًا يدفعان ثمن الوضوح
// الذي تطلبه التفاصيل.
// ============================================================

// خارج المجموعة: من الخافت إلى الممتلئ، ومن الأخضر الداكن إلى الساطع.
منحدر = " .:-=+*#%"
ألوان = [٢٢, ٢٨, ٣٤, ٤٠, ٤٦, ٨٢, ١١٨, ١٥٤, ١٩١]

// الخطوات التي احتملها المدار قبل أن يهرب؛ صفر إن لم يهرب قط.
// تُحمَل مدار_حقيقي٢ و مدار_خيالي٢ معه، فتكلف كل خطوة أربعة جداءات لا ستة.
هروب(نقطة_حقيقي, نقطة_خيالي) {
    مدار_حقيقي  = ٠.٠
    مدار_خيالي  = ٠.٠
    مدار_حقيقي٢ = ٠.٠
    مدار_خيالي٢ = ٠.٠
    @ دورة:١..٣٦ {
        ? مدار_حقيقي٢ + مدار_خيالي٢ > ٤.٠ { <~ دورة }
        مدار_خيالي  = ٢.٠ * مدار_حقيقي * مدار_خيالي + نقطة_خيالي
        مدار_حقيقي  = مدار_حقيقي٢ - مدار_خيالي٢ + نقطة_حقيقي
        مدار_حقيقي٢ = مدار_حقيقي * مدار_حقيقي
        مدار_خيالي٢ = مدار_خيالي * مدار_خيالي
    }
    <~ ٠
}

>>| {
    >>!
    (علو, عرض) = >>?
    صفوف  = علو - ٢
    أعمدة = عرض - ١

    // المربع أطول من عرضه بنحو ٢.٥ مرة؛ فيُقاس المدى الرأسي بذلك
    // حتى تخرج المجموعة مستديرة.
    اتساع  = ٢.٧
    ارتفاع = صفوف * اتساع * ٢.٥ / أعمدة
    الوسط  = صفوف / ٢ + ١

    @ صف:١..الوسط {
        مرآة = صفوف + ١ - صف
        @ عمود:١..أعمدة {
            نقطة_حقيقي = (عمود - ١) * اتساع  / أعمدة - ٢.١
            نقطة_خيالي = (صف   - ١) * ارتفاع / صفوف  - ارتفاع / ٢.٠
            صمود       = هروب(نقطة_حقيقي, نقطة_خيالي)
            علامة      = "@"
            لون        = ٢٣١
            ? صمود <> ٠ {
                خطوة = صمود / ٤ + ١
                ? خطوة > ٩ { خطوة = ٩ }
                علامة = منحدر[خطوة]
                لون   = ألوان[خطوة]
            }
            >>~ (صف, عمود, ٠, لون) > علامة
            ? مرآة > الوسط { >>~ (مرآة, عمود, ٠, لون) > علامة }
        }
    }

    >>~ (علو, ٢, ٠, ٢٤٤) > "اضغط أي مفتاح للخروج"
    <<| _مفتاح
}
