// @skip-parity: تحتاج اللوحة إلى طرفية حقيقية تحت واجهة الأوامر وإلى طبقة لوحة في
// @skip-parity: المتصفح، فالتشغيل عبر أنبوب لا يترك شيئًا يُقارَن.
// ============================================================
// mandelbrot — مجموعة ماندلبرو، مرسومة على لوحة الطرفية.
// الأسماء بالعربية. والعلامات تبقى علامات دائمًا.
//
// عدد واحد يقرر كل شيء: ‏`صمود`‏، كم خطوة يحتمل المدار قبل أن يهرب.
// هو من يختار الحرف، وهو من يختار اللون، فلا تستطيع الصورة أن
// تناقض نفسها. ‏`صمود = 0`‏ يعني أنه لم يهرب قط — تلك هي المجموعة
// نفسها، مرسومة ممتلئة.
//
//   >>|  تفتح اللوحة   >>!  تمسح   >>?  تقيس
//   >>~  تكتب مربعًا واحدًا، في صف واحد، عمود واحد، بلون واحد
//   <<|  تنتظر مفتاحًا واحدًا
//
// توفيران، وكلاهما يُرى في الصورة لا في قياس: تُحمَل المربعات من
// خطوة إلى التي تليها بدل إعادة حسابها، وتُعكَس المجموعة حول المحور
// الحقيقي، فلا يهرب إلا نصفها الأعلى. وهما معًا يدفعان ثمن الوضوح
// الذي تطلبه التفاصيل.
// ============================================================

// خارج المجموعة: من الخافت إلى الممتلئ، ومن الأخضر الداكن إلى الساطع.
منحدر = " .:-=+*#%"
ألوان = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// الخطوات التي احتملها المدار قبل أن يهرب؛ صفر إن لم يهرب قط.
// تُحمَل مدار_حقيقي2 و مدار_خيالي2 معه، فتكلف كل خطوة أربعة جداءات لا ستة.
هروب(نقطة_حقيقي, نقطة_خيالي) {
    مدار_حقيقي  = 0.0
    مدار_خيالي  = 0.0
    مدار_حقيقي2 = 0.0
    مدار_خيالي2 = 0.0
    @ دورة:1..36 {
        ? مدار_حقيقي2 + مدار_خيالي2 > 4.0 { <~ دورة }
        مدار_خيالي  = 2.0 * مدار_حقيقي * مدار_خيالي + نقطة_خيالي
        مدار_حقيقي  = مدار_حقيقي2 - مدار_خيالي2 + نقطة_حقيقي
        مدار_حقيقي2 = مدار_حقيقي * مدار_حقيقي
        مدار_خيالي2 = مدار_خيالي * مدار_خيالي
    }
    <~ 0
}

>>| {
    >>!
    (علو, عرض) = >>?
    صفوف  = علو - 2
    أعمدة = عرض - 1

    // المربع أطول من عرضه بنحو 2.5 مرة؛ فيُقاس المدى الرأسي بذلك
    // حتى تخرج المجموعة مستديرة.
    اتساع  = 2.7
    ارتفاع = صفوف * اتساع * 2.5 / أعمدة
    الوسط  = صفوف / 2 + 1

    @ صف:1..الوسط {
        مرآة = صفوف + 1 - صف
        @ عمود:1..أعمدة {
            نقطة_حقيقي = (عمود - 1) * اتساع  / أعمدة - 2.1
            نقطة_خيالي = (صف   - 1) * ارتفاع / صفوف  - ارتفاع / 2.0
            صمود       = هروب(نقطة_حقيقي, نقطة_خيالي)
            علامة      = "@"
            لون        = 231
            ? صمود <> 0 {
                خطوة = صمود / 4 + 1
                ? خطوة > 9 { خطوة = 9 }
                علامة = منحدر[خطوة]
                لون   = ألوان[خطوة]
            }
            >>~ (صف, عمود, 0, لون) > علامة
            ? مرآة > الوسط { >>~ (مرآة, عمود, 0, لون) > علامة }
        }
    }

    >>~ (علو, 2, 0, 244) > "اضغط أي مفتاح للخروج"
    <<| _مفتاح
}
