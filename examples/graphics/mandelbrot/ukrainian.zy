// @skip-parity: полотну потрібен справжній термінал під CLI і шар полотна в
// @skip-parity: браузері, тож прогін через конвеєр не має з чим порівнюватися.
// ============================================================
// mandelbrot — множина Мандельброта, намальована на полотні термінала.
// Імена українською. Знаки завжди лишаються знаками.
//
// Усе вирішує одне число: `n`, скільки кроків орбіта витримує,
// перш ніж утекти. Воно обирає накреслення і обирає колір, тож
// малюнок не може сам собі суперечити. `n = 0` означає, що вона
// не втекла ніколи — це і є множина, намальована суцільно.
//
//   >>|  відкриває полотно   >>!  чистить його   >>?  міряє його
//   >>~  пише одну клітинку, у рядку, у стовпці, одним кольором
//   <<|  чекає на клавішу
//
// Дві ощадності, і обидві видно на малюнку, а не в замірі:
// квадрати переносяться з кроку на крок замість перерахунку, а
// множина дзеркалиться відносно дійсної осі, тож тікає лише
// верхня половина. Разом вони оплачують ту роздільність, якої
// вимагає деталь.
// ============================================================

// Поза множиною: від блідого до суцільного, від темно-зеленого до яскравого.
шкала   = " .:-=+*#%"
кольори = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Кроки, витримані до втечі орбіти; 0, якщо вона не тікає.
// zr2 і zi2 переносяться, тож кожен крок коштує чотири множення, а не шість.
втеча(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (високо, широко) = >>?
    рядки   = високо - 2
    стовпці = широко - 1

    // Клітинка приблизно у 2,5 раза вища, ніж ширша; вертикальний
    // розмах на це масштабується, щоб множина вийшла круглою.
    ширина   = 2.7
    висота   = рядки * ширина * 2.5 / стовпці
    середина = рядки / 2 + 1

    @ y:1..середина {
        дзеркало = рядки + 1 - y
        @ x:1..стовпці {
            cr = (x - 1) * ширина / стовпці - 2.1
            ci = (y - 1) * висота / рядки   - висота / 2.0
            n  = втеча(cr, ci)
            знак  = "@"
            колір = 231
            ? n <> 0 {
                крок = n / 4 + 1
                ? крок > 9 { крок = 9 }
                знак  = шкала[крок]
                колір = кольори[крок]
            }
            >>~ (y, x, 0, колір) > знак
            ? дзеркало > середина { >>~ (дзеркало, x, 0, колір) > знак }
        }
    }

    >>~ (високо, 2, 0, 244) > "будь-яка клавіша для виходу"
    <<| _клавіша
}
