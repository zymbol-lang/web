// @skip-parity:    CLI      ,
// @skip-parity:        .
// ============================================================
// mandelbrot — mandelbrot ,   .
//   .    .
//
//    : `n`,     .  ,
//   ,     . `n = 0`
//  —  ,  .
//
//   >>|      >>!     >>?  
//   >>~    ,  ,  ,  
//   <<|    
//
//   ,     : 
//      ,  
//   ,     .   
//   .
// ============================================================

//  :   ,    .
  = " .:-=+*#%"
 = [22, 28, 34, 40, 46, 82, 118, 154, 191]

//     ;    0.
// zr2 zi2  ,     ,  .
(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (, ) = >>?
     =   - 2
        =  - 1

    //      ,  2.5.    ,
    //   .
    _ = 2.7
    _  =  * _ * 2.5 / 
        =  / 2 + 1

    @ y:1.. {
         =  + 1 - y
        @ x:1.. {
            cr = (x - 1) * _ /     - 2.1
            ci = (y - 1) * _  /  - _ / 2.0
            n  = (cr, ci)
              = "@"
             = 231
            ? n <> 0 {
                 = n / 4 + 1
                ?  > 9 {  = 9 }
                  = []
                 = []
            }
            >>~ (y, x, 0, ) > 
            ?  >  { >>~ (, x, 0, ) >  }
        }
    }

    >>~ (, 2, 0, 244) > "    "
    <<| _
}
