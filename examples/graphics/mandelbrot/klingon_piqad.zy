// @skip-parity:    CLI      ,
// @skip-parity:        .
// ============================================================
// mandelbrot — mandelbrot ,   .
//   .    .
//
//    : ``,     .  ,
//   ,     . ` = 0`
//  —  ,  .
//
//   >>|      >>!     >>?  
//   >>~    ,  ,  ,  
//   <<|    
//
//   ,     : 
//      ,  
//   ,     .   
//   .
// ============================================================

//  :   ,    .
 = " .:-=+*#%"
 = [22, 28, 34, 40, 46, 82, 118, 154, 191]

//     ;    0.
// _2 _2  ,     ,  .
(_, _) {
    _  = 0.0
    _  = 0.0
    _2 = 0.0
    _2 = 0.0
    @ :1..36 {
        ? _2 + _2 > 4.0 { <~  }
        _  = 2.0 * _ * _ + _
        _  = _2 - _2 + _
        _2 = _ * _
        _2 = _ * _
    }
    <~ 0
}

>>| {
    >>!
    (, ) = >>?
     =   - 2
     =  - 1

    //      ,  2.5.    ,
    //   .
    _ = 2.7
    _  =  * _ * 2.5 / 
         =  / 2 + 1

    @ :1.. {
         =  + 1 - 
        @ :1.. {
            _ = ( - 1) * _ /  - 2.1
            _ = ( - 1) * _  /  - _ / 2.0
                 = (_, _)
                 = "@"
                 = 231
            ?  <> 0 {
                 =  / 4 + 1
                ?  > 9 {  = 9 }
                 = []
                 = []
            }
            >>~ (, , 0, ) > 
            ?  >  { >>~ (, , 0, ) >  }
        }
    }

    >>~ (, 2, 0, 244) > "    "
    <<| _
}
