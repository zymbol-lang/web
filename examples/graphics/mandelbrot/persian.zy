// @skip-parity: بوم به یک پایانهٔ واقعی زیر خط فرمان و به یک لایهٔ بوم در مرورگر
// @skip-parity: نیاز دارد، پس اجرا از راه لوله چیزی برای مقایسه باقی نمی‌گذارد.
// ============================================================
// mandelbrot — مجموعهٔ ماندلبرو، کشیده بر بوم پایانه.
// نام‌ها به فارسی. نشانه‌ها همیشه نشانه می‌مانند.
//
// یک عدد همه چیز را تعیین می‌کند: ‏`n`‏، مدار پیش از گریختن چند گام
// تاب می‌آورد. همان است که حرف را برمی‌گزیند و همان است که رنگ را
// برمی‌گزیند؛ پس تصویر نمی‌تواند با خودش ناسازگار باشد. ‏`n = 0`‏
// یعنی هرگز نگریخت — آن خودِ مجموعه است، پُر کشیده.
//
//   >>|  بوم را می‌گشاید   >>!  پاک می‌کند   >>?  اندازه می‌گیرد
//   >>~  یک خانه می‌نویسد، در یک سطر، یک ستون، با یک رنگ
//   <<|  منتظر یک کلید می‌ماند
//
// دو صرفه‌جویی، و هر دو در تصویر دیده می‌شوند نه در اندازه‌گیری:
// مربع‌ها از گامی به گام بعد حمل می‌شوند به جای آنکه دوباره حساب
// شوند، و مجموعه گرد محور حقیقی آینه می‌شود، پس تنها نیمهٔ بالا
// می‌گریزد. این دو با هم بهای وضوحی را می‌پردازند که جزئیات می‌خواهد.
// ============================================================

// بیرون از مجموعه: از کم‌رنگ تا پُر، از سبز تیره تا روشن.
شیب    = " .:-=+*#%"
رنگ‌ها = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// گام‌هایی که مدار پیش از گریختن تاب آورد؛ اگر هرگز نگریخت، صفر.
// zr2 و zi2 با آن حمل می‌شوند، پس هر گام چهار ضرب هزینه دارد نه شش.
گریز(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (بلندا, پهنا) = >>?
    سطرها   = بلندا - 2
    ستون‌ها = پهنا  - 1

    // یک خانه نزدیک ۲٫۵ برابر پهنایش بلند است؛ گسترهٔ عمودی با همان
    // مقیاس می‌شود تا مجموعه گرد درآید.
    پهنای_صفحه = 2.7
    بلندای_صفحه = سطرها * پهنای_صفحه * 2.5 / ستون‌ها
    میانه       = سطرها / 2 + 1

    @ y:1..میانه {
        آینه = سطرها + 1 - y
        @ x:1..ستون‌ها {
            cr = (x - 1) * پهنای_صفحه  / ستون‌ها - 2.1
            ci = (y - 1) * بلندای_صفحه / سطرها   - بلندای_صفحه / 2.0
            n  = گریز(cr, ci)
            نشانه = "@"
            رنگ    = 231
            ? n <> 0 {
                گام = n / 4 + 1
                ? گام > 9 { گام = 9 }
                نشانه = شیب[گام]
                رنگ    = رنگ‌ها[گام]
            }
            >>~ (y, x, 0, رنگ) > نشانه
            ? آینه > میانه { >>~ (آینه, x, 0, رنگ) > نشانه }
        }
    }

    >>~ (بلندا, 2, 0, 244) > "برای خروج هر کلیدی را بزنید"
    <<| _کلید
}
