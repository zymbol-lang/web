// @skip-parity: הבד דורש מסוף אמיתי תחת שורת הפקודה ושכבת בד בדפדפן,
// @skip-parity: ולכן הרצה דרך צינור אינה משאירה דבר להשוואה.
// ============================================================
// mandelbrot — קבוצת מנדלברוט, מצוירת על בד המסוף.
// השמות בעברית. הסימנים נשארים סימנים תמיד.
//
// מספר אחד מכריע הכול: ‏`עמידות`‏, כמה צעדים המסלול סובל לפני שהוא בורח.
// הוא שבוחר את התו והוא שבוחר את הגוון, ולכן התמונה אינה יכולה
// לסתור את עצמה. ‏`עמידות = 0`‏ פירושו שהוא לא ברח מעולם — זו הקבוצה
// עצמה, מצוירת מלאה.
//
//   >>|  פותח את הבד   >>!  מוחק   >>?  מודד
//   >>~  כותב תא אחד, בשורה אחת, בעמודה אחת, בגוון אחד
//   <<|  ממתין למקש אחד
//
// שני חיסכונות, ושניהם נראים בתמונה ולא במדידה: הריבועים נישאים
// מצעד אחד לזה שאחריו במקום שיחושבו מחדש, והקבוצה משתקפת סביב
// הציר הממשי, ולכן רק החצי העליון בורח. שניהם יחד משלמים על
// החדות שהפרטים דורשים.
// ============================================================

// מחוץ לקבוצה: מן הדהוי אל המלא, מן הירוק הכהה אל הבהיר.
מדרון  = " .:-=+*#%"
גוונים = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// הצעדים שנסבלו לפני שהמסלול ברח; אפס אם לא ברח מעולם.
// מסלול_ממשי2 ו-מסלול_מדומה2 נישאים עמו, ולכן כל צעד עולה ארבע מכפלות ולא שש.
בריחה(נקודה_ממשי, נקודה_מדומה) {
    מסלול_ממשי   = 0.0
    מסלול_מדומה  = 0.0
    מסלול_ממשי2  = 0.0
    מסלול_מדומה2 = 0.0
    @ סיבוב:1..36 {
        ? מסלול_ממשי2 + מסלול_מדומה2 > 4.0 { <~ סיבוב }
        מסלול_מדומה  = 2.0 * מסלול_ממשי * מסלול_מדומה + נקודה_מדומה
        מסלול_ממשי   = מסלול_ממשי2 - מסלול_מדומה2 + נקודה_ממשי
        מסלול_ממשי2  = מסלול_ממשי * מסלול_ממשי
        מסלול_מדומה2 = מסלול_מדומה * מסלול_מדומה
    }
    <~ 0
}

>>| {
    >>!
    (גובה, רוחב) = >>?
    שורות  = גובה - 2
    עמודות = רוחב - 1

    // תא גבוה מרוחבו פי 2.5 בערך; המוטה האנכי מוקטן בהתאם
    // כדי שהקבוצה תצא עגולה.
    רוחב_המישור = 2.7
    גובה_המישור = שורות * רוחב_המישור * 2.5 / עמודות
    אמצע        = שורות / 2 + 1

    @ שורה:1..אמצע {
        מראה = שורות + 1 - שורה
        @ עמודה:1..עמודות {
            נקודה_ממשי  = (עמודה - 1) * רוחב_המישור / עמודות - 2.1
            נקודה_מדומה = (שורה  - 1) * גובה_המישור / שורות  - גובה_המישור / 2.0
            עמידות      = בריחה(נקודה_ממשי, נקודה_מדומה)
            סימן        = "@"
            גוון        = 231
            ? עמידות <> 0 {
                צעד = עמידות / 4 + 1
                ? צעד > 9 { צעד = 9 }
                סימן = מדרון[צעד]
                גוון = גוונים[צעד]
            }
            >>~ (שורה, עמודה, 0, גוון) > סימן
            ? מראה > אמצע { >>~ (מראה, עמודה, 0, גוון) > סימן }
        }
    }

    >>~ (גובה, 2, 0, 244) > "הקש מקש כלשהו כדי לצאת"
    <<| _מקש
}
