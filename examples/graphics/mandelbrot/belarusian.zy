// @skip-parity: палатну патрэбны сапраўдны тэрмінал пад CLI і слой палатна ў
// @skip-parity: браўзеры, таму запуск праз трубу няма з чым параўнаць.
// ============================================================
// mandelbrot — мноства Мандэльброта, намаляванае на палатне тэрмінала.
// Імёны па-беларуску. Знакі заўсёды застаюцца знакамі.
//
// Усё вырашае адзін лік: `вытрымка`, колькі крокаў арбіта вытрымлівае,
// перш чым уцячы. Ён выбірае знак і ён выбірае колер, таму малюнак
// не можа сам сабе супярэчыць. `вытрымка = 0` значыць, што яна не ўцякла
// ніколі — гэта і ёсць мноства, намалявана суцэльна.
//
//   >>|  адкрывае палатно   >>!  чысціць яго   >>?  мерае яго
//   >>~  піша адну клетку, у радку, у слупку, адным колерам
//   <<|  чакае клавішу
//
// Дзве ашчаднасці, і абедзве відаць на малюнку, а не ў замеры:
// квадраты пераносяцца з кроку на крок замест пералічэння, а
// мноства люстраецца адносна рэчаіснай восі, таму ўцякае толькі
// верхняя палова. Разам яны аплачваюць тую разрознасць, якой
// патрабуе дэталь.
// ============================================================

// Па-за мноствам: ад бледнага да суцэльнага, ад цёмна-зялёнага да яркага.
шкала  = " .:-=+*#%"
колеры = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Крокі, вытрыманыя да ўцёкаў арбіты; 0, калі яна не ўцякае ніколі.
// арбіта_сапраўдная2 і арбіта_уяўная2 пераносяцца, таму кожны крок каштуе чатыры множанні, а не шэсць.
уцёкі(пункт_сапраўдная, пункт_уяўная) {
    арбіта_сапраўдная  = 0.0
    арбіта_уяўная      = 0.0
    арбіта_сапраўдная2 = 0.0
    арбіта_уяўная2     = 0.0
    @ віток:1..36 {
        ? арбіта_сапраўдная2 + арбіта_уяўная2 > 4.0 { <~ віток }
        арбіта_уяўная      = 2.0 * арбіта_сапраўдная * арбіта_уяўная + пункт_уяўная
        арбіта_сапраўдная  = арбіта_сапраўдная2 - арбіта_уяўная2 + пункт_сапраўдная
        арбіта_сапраўдная2 = арбіта_сапраўдная * арбіта_сапраўдная
        арбіта_уяўная2     = арбіта_уяўная * арбіта_уяўная
    }
    <~ 0
}

>>| {
    >>!
    (высока, шырока) = >>?
    радкі  = высока - 2
    слупкі = шырока - 1

    // Клетка прыкладна ў 2,5 разы вышэйшая, чым шырэйшая; вертыкальны
    // размах на гэта маштабуецца, каб мноства выйшла круглым.
    шырыня    = 2.7
    вышыня    = радкі * шырыня * 2.5 / слупкі
    сярэдзіна = радкі / 2 + 1

    @ радок:1..сярэдзіна {
        люстра = радкі + 1 - радок
        @ слупок:1..слупкі {
            пункт_сапраўдная = (слупок - 1) * шырыня / слупкі - 2.1
            пункт_уяўная     = (радок  - 1) * вышыня / радкі  - вышыня / 2.0
            вытрымка         = уцёкі(пункт_сапраўдная, пункт_уяўная)
            знак             = "@"
            колер            = 231
            ? вытрымка <> 0 {
                крок = вытрымка / 4 + 1
                ? крок > 9 { крок = 9 }
                знак  = шкала[крок]
                колер = колеры[крок]
            }
            >>~ (радок, слупок, 0, колер) > знак
            ? люстра > сярэдзіна { >>~ (люстра, слупок, 0, колер) > знак }
        }
    }

    >>~ (высока, 2, 0, 244) > "любая клавіша для выхаду"
    <<| _клавіша
}
