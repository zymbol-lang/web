// @skip-parity: палатну патрэбны сапраўдны тэрмінал пад CLI і слой палатна ў
// @skip-parity: браўзеры, таму запуск праз трубу няма з чым параўнаць.
// ============================================================
// mandelbrot — мноства Мандэльброта, намаляванае на палатне тэрмінала.
// Імёны па-беларуску. Знакі заўсёды застаюцца знакамі.
//
// Усё вырашае адзін лік: `n`, колькі крокаў арбіта вытрымлівае,
// перш чым уцячы. Ён выбірае знак і ён выбірае колер, таму малюнак
// не можа сам сабе супярэчыць. `n = 0` значыць, што яна не ўцякла
// ніколі — гэта і ёсць мноства, намалявана суцэльна.
//
//   >>|  адкрывае палатно   >>!  чысціць яго   >>?  мерае яго
//   >>~  піша адну клетку, у радку, у слупку, адным колерам
//   <<|  чакае клавішу
//
// Дзве ашчаднасці, і абедзве відаць на малюнку, а не ў замеры:
// квадраты пераносяцца з кроку на крок замест пералічэння, а
// мноства люстраецца адносна рэчаіснай восі, таму ўцякае толькі
// верхняя палова. Разам яны аплачваюць тую разрознасць, якой
// патрабуе дэталь.
// ============================================================

// Па-за мноствам: ад бледнага да суцэльнага, ад цёмна-зялёнага да яркага.
шкала  = " .:-=+*#%"
колеры = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Крокі, вытрыманыя да ўцёкаў арбіты; 0, калі яна не ўцякае ніколі.
// zr2 і zi2 пераносяцца, таму кожны крок каштуе чатыры множанні, а не шэсць.
уцёкі(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (высока, шырока) = >>?
    радкі  = высока - 2
    слупкі = шырока - 1

    // Клетка прыкладна ў 2,5 разы вышэйшая, чым шырэйшая; вертыкальны
    // размах на гэта маштабуецца, каб мноства выйшла круглым.
    шырыня   = 2.7
    вышыня   = радкі * шырыня * 2.5 / слупкі
    сярэдзіна = радкі / 2 + 1

    @ y:1..сярэдзіна {
        люстра = радкі + 1 - y
        @ x:1..слупкі {
            cr = (x - 1) * шырыня / слупкі - 2.1
            ci = (y - 1) * вышыня / радкі  - вышыня / 2.0
            n  = уцёкі(cr, ci)
            знак  = "@"
            колер = 231
            ? n <> 0 {
                крок = n / 4 + 1
                ? крок > 9 { крок = 9 }
                знак  = шкала[крок]
                колер = колеры[крок]
            }
            >>~ (y, x, 0, колер) > знак
            ? люстра > сярэдзіна { >>~ (люстра, x, 0, колер) > знак }
        }
    }

    >>~ (высока, 2, 0, 244) > "любая клавіша для выхаду"
    <<| _клавіша
}
