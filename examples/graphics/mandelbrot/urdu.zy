// @skip-parity: کینوس کو کمانڈ لائن کے نیچے ایک اصلی ٹرمینل اور براؤزر میں ایک
// @skip-parity: کینوس پرت درکار ہے، سو پائپ سے چلانے پر موازنے کے لیے کچھ نہیں بچتا۔
// ============================================================
// mandelbrot — مینڈلبرو مجموعہ، ٹرمینل کے کینوس پر بنایا گیا۔
// نام اردو میں۔ نشانات ہمیشہ نشانات ہی رہتے ہیں۔
//
// ایک عدد سب کچھ طے کرتا ہے: ‏`سہار`‏، مدار فرار سے پہلے کتنے قدم برداشت
// کرتا ہے۔ وہی حرف چنتا ہے اور وہی رنگ چنتا ہے، سو تصویر خود کی
// تردید نہیں کر سکتی۔ ‏`سہار = 0`‏ کا مطلب ہے کہ وہ کبھی فرار نہ ہوا —
// وہی خود مجموعہ ہے، بھرا ہوا بنا۔
//
//   >>|  کینوس کھولتا ہے   >>!  مٹاتا ہے   >>?  ناپتا ہے
//   >>~  ایک خانہ لکھتا ہے، ایک سطر میں، ایک ستون، ایک رنگ سے
//   <<|  ایک کنجی کا انتظار کرتا ہے
//
// دو بچتیں، اور دونوں تصویر میں نظر آتی ہیں کسی پیمائش میں نہیں:
// مربعے ایک قدم سے اگلے تک ساتھ لے جائے جاتے ہیں بجائے دوبارہ حساب
// کرنے کے، اور مجموعہ حقیقی محور کے گرد آئینے میں دکھایا جاتا ہے،
// سو صرف اوپر کا آدھا حصہ فرار ہوتا ہے۔ دونوں مل کر اُس صفائی کی
// قیمت ادا کرتے ہیں جو تفصیل مانگتی ہے۔
// ============================================================

// مجموعے سے باہر: مدھم سے بھرے تک، گہرے سبز سے روشن تک۔
ڈھلان    = " .:-=+*#%"
تمام_رنگ = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// وہ قدم جو مدار نے فرار سے پہلے برداشت کیے؛ اگر کبھی فرار نہ ہوا تو صفر۔
// مدار_حقیقی2 اور مدار_خیالی2 ساتھ لے جائے جاتے ہیں، سو ہر قدم چار ضرب لیتا ہے، چھ نہیں۔
فرار(نقطہ_حقیقی, نقطہ_خیالی) {
    مدار_حقیقی  = 0.0
    مدار_خیالی  = 0.0
    مدار_حقیقی2 = 0.0
    مدار_خیالی2 = 0.0
    @ چکر:1..36 {
        ? مدار_حقیقی2 + مدار_خیالی2 > 4.0 { <~ چکر }
        مدار_خیالی  = 2.0 * مدار_حقیقی * مدار_خیالی + نقطہ_خیالی
        مدار_حقیقی  = مدار_حقیقی2 - مدار_خیالی2 + نقطہ_حقیقی
        مدار_حقیقی2 = مدار_حقیقی * مدار_حقیقی
        مدار_خیالی2 = مدار_خیالی * مدار_خیالی
    }
    <~ 0
}

>>| {
    >>!
    (اونچائی, چوڑائی) = >>?
    سطریں = اونچائی - 2
    ستون  = چوڑائی - 1

    // ایک خانہ اپنی چوڑائی سے تقریباً 2.5 گنا اونچا ہے؛ عمودی پھیلاؤ
    // اسی سے ناپا جاتا ہے تاکہ مجموعہ گول نکلے۔
    چوڑائی_میدان  = 2.7
    اونچائی_میدان = سطریں * چوڑائی_میدان * 2.5 / ستون
    درمیان        = سطریں / 2 + 1

    @ سطر_نمبر:1..درمیان {
        آئینہ = سطریں + 1 - سطر_نمبر
        @ ستون_نمبر:1..ستون {
            نقطہ_حقیقی = (ستون_نمبر - 1) * چوڑائی_میدان  / ستون  - 2.1
            نقطہ_خیالی = (سطر_نمبر  - 1) * اونچائی_میدان / سطریں - اونچائی_میدان / 2.0
            سہار       = فرار(نقطہ_حقیقی, نقطہ_خیالی)
            نشان       = "@"
            رنگ        = 231
            ? سہار <> 0 {
                قدم = سہار / 4 + 1
                ? قدم > 9 { قدم = 9 }
                نشان = ڈھلان[قدم]
                رنگ  = تمام_رنگ[قدم]
            }
            >>~ (سطر_نمبر, ستون_نمبر, 0, رنگ) > نشان
            ? آئینہ > درمیان { >>~ (آئینہ, ستون_نمبر, 0, رنگ) > نشان }
        }
    }

    >>~ (اونچائی, 2, 0, 244) > "نکلنے کے لیے کوئی بھی کنجی دبائیں"
    <<| _کنجی
}
