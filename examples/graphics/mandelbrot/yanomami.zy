// @skip-parity: hei mesi thëpë terminal thë waroho CLI hami, mesi thë pëhëtëo
// @skip-parity: napë mesi hami, ai hwei thë kua tute mahi thë kuo mai.
// ============================================================
// mandelbrot — hei Mandelbrot pëhëtëo, mesi hami thë mãyõ.
// Yanomamɨ thëpë ãhã. Mesipë hwei mesipë tute.
//
// Mõrĩ thë ãhã pëhëtëo kuaɨ: `n`, hɨrama pei thë kuo hwei
// thë waripo mai. Kamiyë mesi hɨpɨ, ai thë ũxi hɨpɨ, hwei
// mãyõ thë kuo mai kama hami. `n = 0` thë kuo waripo mai —
// hwei pëhëtëo, thë mãyõ kua.
//
//   >>|  mesi thë hetu   >>!  thë xatiho   >>?  thë hɨrama
//   >>~  mõrĩ thë kuo mãyõ, mõrĩ mesipë, mõrĩ pata, mõrĩ ũxi
//   <<|  mõrĩ nahi wamotima
//
// Porakapɨ thë kuaɨ, ai porakapɨ mesi hami thë kuo, hɨrama hami
// thë kuo mai: porakapɨ thëpë hwei kuo hami ai kuo hami thëpë
// waroho, hɨrama tute mai, ai pëhëtëo mesi hami thë waroho, hwei
// pata hami mõrĩ thë waripo. Porakapɨ thë kuo hɨpɨ.
//
// Thëpë ãhã tute: `mesipë`, `ũxipë`, `waripo`, `pata`, `hetupë`,
// `mãyõmɨ`, `pei`, `nahi`, `hɨramapë` ai `patapë` hei hami thë
// kuaɨ. Yanomamɨ thëpë ãhã taai kuaɨ.
// ============================================================

// Pëhëtëo hami mai: thë xori hami thë kua, urihi hami thë wakë.
mesipë = " .:-=+*#%"
ũxipë  = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Hɨrama pei thë kuo hwei thë waripo mai; 0 thë waripo mai kuo.
// zr2 ai zi2 thë waroho, hwei mõrĩ pei porakapɨ thë kuaɨ, hɨrama mai.
waripo(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (hɨrama, pata) = >>?
    mãyõ   = hɨrama - 2
    hetupë = pata   - 1

    // Mõrĩ thë kuo ~2.5 hɨrama pata hami; hɨrama thë kuaɨ
    // hwei thë hɨpɨ pëhëtëo thë morayoma.
    patapë   = 2.7
    hɨramapë = mãyõ * patapë * 2.5 / hetupë
    pei      = mãyõ / 2 + 1

    @ y:1..pei {
        mãyõmɨ = mãyõ + 1 - y
        @ x:1..hetupë {
            cr = (x - 1) * patapë   / hetupë - 2.1
            ci = (y - 1) * hɨramapë / mãyõ   - hɨramapë / 2.0
            n  = waripo(cr, ci)
            mesi = "@"
            ũxi  = 231
            ? n <> 0 {
                nahi = n / 4 + 1
                ? nahi > 9 { nahi = 9 }
                mesi = mesipë[nahi]
                ũxi  = ũxipë[nahi]
            }
            >>~ (y, x, 0, ũxi) > mesi
            ? mãyõmɨ > pei { >>~ (mãyõmɨ, x, 0, ũxi) > mesi }
        }
    }

    >>~ (hɨrama, 2, 0, 244) > "mõrĩ nahi wamotima wa huu"
    <<| _wamotima
}
