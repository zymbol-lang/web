// @skip-parity: 화폭은 CLI 아래에서 진짜 단말을, 브라우저에서는 화폭 층을
// @skip-parity: 필요로 하므로, 파이프를 거친 실행에는 견줄 것이 없다.
// ============================================================
// mandelbrot — 만델브로 집합을 단말의 화폭에 그린다.
// 이름은 한국어로. 기호는 언제나 기호다.
//
// 모든 것을 정하는 것은 하나의 수다. `버팀`, 궤도가 발산하기까지
// 견딘 단계의 수. 그것이 글자를 고르고 그것이 색을 고르므로,
// 그림은 스스로와 어긋날 수 없다. `버팀 = 0` 은 한 번도 발산하지
// 않았다는 뜻 — 그것이 집합이며, 가득 찬 글자로 그려진다.
//
//   >>|  화폭을 연다   >>!  지운다   >>?  잰다
//   >>~  한 칸을, 한 행에, 한 열에, 한 색으로 쓴다
//   <<|  키를 기다린다
//
// 아낌이 둘, 둘 다 재기가 아니라 그림에 드러난다. 제곱은 단계에서
// 단계로 옮겨지고 다시 셈하지 않으며, 집합은 실수축을 둘러 거울에
// 비치므로 위쪽 절반만이 발산한다. 둘이 함께, 세부가 요구하는
// 해상도를 치른다.
// ============================================================

// 집합 바깥 — 옅음에서 가득함으로, 짙은 초록에서 밝음으로.
명암 = " .:-=+*#%"
색표 = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// 궤도가 발산하기까지 견딘 단계; 한 번도 발산하지 않으면 0.
// 궤실2 와 궤허2 는 함께 옮겨지므로 한 단계는 곱 넷을 치르며, 여섯이 아니다.
발산(점실, 점허) {
    궤실  = 0.0
    궤허  = 0.0
    궤실2 = 0.0
    궤허2 = 0.0
    @ 바퀴:1..36 {
        ? 궤실2 + 궤허2 > 4.0 { <~ 바퀴 }
        궤허  = 2.0 * 궤실 * 궤허 + 점허
        궤실  = 궤실2 - 궤허2 + 점실
        궤실2 = 궤실 * 궤실
        궤허2 = 궤허 * 궤허
    }
    <~ 0
}

>>| {
    >>!
    (세로, 가로) = >>?
    행 = 세로 - 2
    열 = 가로 - 1

    // 한 칸은 너비보다 약 2.5 배 높으므로, 세로 폭을 그만큼
    // 줄여 집합이 둥글게 나오도록 한다.
    너비   = 2.7
    높이   = 행 * 너비 * 2.5 / 열
    가운데 = 행 / 2 + 1

    @ 행번:1..가운데 {
        거울 = 행 + 1 - 행번
        @ 열번:1..열 {
            점실 = (열번 - 1) * 너비 / 열 - 2.1
            점허 = (행번 - 1) * 높이 / 행 - 높이 / 2.0
            버팀 = 발산(점실, 점허)
            기호 = "@"
            색   = 231
            ? 버팀 <> 0 {
                단계 = 버팀 / 4 + 1
                ? 단계 > 9 { 단계 = 9 }
                기호 = 명암[단계]
                색   = 색표[단계]
            }
            >>~ (행번, 열번, 0, 색) > 기호
            ? 거울 > 가운데 { >>~ (거울, 열번, 0, 색) > 기호 }
        }
    }

    >>~ (세로, 2, 0, 244) > "아무 키나 누르면 끝납니다"
    <<| _키
}
