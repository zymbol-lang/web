// @skip-parity: kanvas di bin CLI de termînaleke rastîn û di gerokê de qatek kanvasê
// @skip-parity: dixwaze, ji ber vê yekê xebitandina bi boriyê tiştekî ji bo berhevdanê nahêle.
// ============================================================
// mandelbrot — koma Mandelbrot, li ser kanvasa termînalê hatiye kişandin.
// Nav bi Kurdî. Nîşan her dem nîşan dimînin.
//
// Hejmarek her tiştî diyar dike: `n`, çend gav gerok berî ku birevin
// li ber xwe dide. Ew e ku tîpê hildibijêre û ew e ku rengî
// hildibijêre; ji ber vê yekê wêne nikare bi xwe re nakok be. `n = 0`
// tê wateya ku qet nereviya — ew bi xwe kom e, tijî hatiye kişandin.
//
//   >>|  kanvasê vedike   >>!  paqij dike   >>?  dipîve
//   >>~  yek qutiyê dinivîse, di rêzek de, stûnek, bi rengekî
//   <<|  li benda kilîtekê dimîne
//
// Du teserûf, û herdu jî di wêneyê de xuya dibin ne di pîvanekê de:
// çargoşe ji gavekê ber bi ya din ve tên hilgirtin li şûna ku ji nû ve
// bên hesabkirin, û kom li dora tewereya rastîn tê neynikkirin, ji ber
// vê yekê tenê nîvê jorîn direve. Herdu bi hev re biha wê zelaliyê
// didin ku hûrgulî dixwaze.
// ============================================================

// Li derveyî komê: ji kêmreng ber bi tijî, ji kesk a tarî ber bi ronî.
hilkêş = " .:-=+*#%"
reng   = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Gavên ku berî revê hatin ragirtin; ger qet nereviya 0.
// zr2 û zi2 pê re tên hilgirtin, ji ber vê yekê her gav çar lêdan dixwaze ne şeş.
rev(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (bilindahî, firehî) = >>?
    rêz   = bilindahî - 2
    stûn  = firehî    - 1

    // Qutiyek ji firehiya xwe nêzîkî 2.5 caran bilindtir e; berfirehiya
    // sertîk li gorî wê tê pîvandin da ku kom gilover derkeve.
    firehiyaRû   = 2.7
    bilindahiyaRû = rêz * firehiyaRû * 2.5 / stûn
    navîn        = rêz / 2 + 1

    @ y:1..navîn {
        neynik = rêz + 1 - y
        @ x:1..stûn {
            cr = (x - 1) * firehiyaRû    / stûn - 2.1
            ci = (y - 1) * bilindahiyaRû / rêz  - bilindahiyaRû / 2.0
            n  = rev(cr, ci)
            nîşan = "@"
            rengek = 231
            ? n <> 0 {
                gav = n / 4 + 1
                ? gav > 9 { gav = 9 }
                nîşan  = hilkêş[gav]
                rengek = reng[gav]
            }
            >>~ (y, x, 0, rengek) > nîşan
            ? neynik > navîn { >>~ (neynik, x, 0, rengek) > nîşan }
        }
    }

    >>~ (bilindahî, 2, 0, 244) > "ji bo derketinê kilîtekê bitikîne"
    <<| _kilît
}
