// @skip-parity: পটের জন্য CLI-এর নিচে সত্যিকারের টার্মিনাল আর ব্রাউজারে পটের
// @skip-parity: একটি স্তর দরকার, তাই পাইপ দিয়ে চালালে তুলনা করার কিছু থাকে না।
// ============================================================
// mandelbrot — মান্ডেলব্রট সেট, টার্মিনালের পটে আঁকা।
// নাম বাংলায়। চিহ্ন সব সময় চিহ্নই থাকে।
//
// সব ঠিক করে একটিমাত্র সংখ্যা: `সহন`, কক্ষপথ পালানোর আগে কত ধাপ
// টিকে থাকে। সেটিই অক্ষর বাছে আর সেটিই রং বাছে, তাই ছবি নিজের
// সঙ্গে বিরোধ করতে পারে না। `সহন = 0` মানে সে কখনও পালায়নি —
// সেটিই সেট, ভরাট করে আঁকা।
//
//   >>|  পট খোলে   >>!  মোছে   >>?  মাপে
//   >>~  একটি ঘর লেখে, একটি সারিতে, একটি স্তম্ভে, একটি রঙে
//   <<|  একটি চাবির অপেক্ষা করে
//
// দুটি সাশ্রয়, আর দুটিই মাপে নয়, ছবিতেই দেখা যায়: বর্গগুলি এক ধাপ
// থেকে পরের ধাপে বয়ে নেওয়া হয়, আবার হিসাব করা হয় না, আর সেট
// বাস্তব অক্ষের চারপাশে দর্পিত হয়, তাই কেবল উপরের অর্ধেকই পালায়।
// দুইয়ে মিলে সেই স্পষ্টতার দাম দেয় যা খুঁটিনাটি চায়।
// ============================================================

// সেটের বাইরে: ফিকে থেকে ভরাট, গাঢ় সবুজ থেকে উজ্জ্বল।
ঢাল    = " .:-=+*#%"
রঙাবলি = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// কক্ষপথ পালানোর আগে টেকা ধাপ; কখনও না পালালে ০।
// কক্ষ_বাস্তব2 আর কক্ষ_কাল্পনিক2 বয়ে নেওয়া হয়, তাই প্রতি ধাপে চারটি গুণ লাগে, ছয়টি নয়।
পলায়ন(বিন্দু_বাস্তব, বিন্দু_কাল্পনিক) {
    কক্ষ_বাস্তব    = 0.0
    কক্ষ_কাল্পনিক  = 0.0
    কক্ষ_বাস্তব2   = 0.0
    কক্ষ_কাল্পনিক2 = 0.0
    @ পাক:1..36 {
        ? কক্ষ_বাস্তব2 + কক্ষ_কাল্পনিক2 > 4.0 { <~ পাক }
        কক্ষ_কাল্পনিক  = 2.0 * কক্ষ_বাস্তব * কক্ষ_কাল্পনিক + বিন্দু_কাল্পনিক
        কক্ষ_বাস্তব    = কক্ষ_বাস্তব2 - কক্ষ_কাল্পনিক2 + বিন্দু_বাস্তব
        কক্ষ_বাস্তব2   = কক্ষ_বাস্তব * কক্ষ_বাস্তব
        কক্ষ_কাল্পনিক2 = কক্ষ_কাল্পনিক * কক্ষ_কাল্পনিক
    }
    <~ 0
}

>>| {
    >>!
    (উঁচু, চওড়া) = >>?
    সারি = উঁচু  - 2
    স্তম্ভ = চওড়া - 1

    // একটি ঘর তার প্রস্থের চেয়ে প্রায় ২.৫ গুণ উঁচু; খাড়া বিস্তার
    // সেই অনুপাতে মাপা হয় যাতে সেট গোল হয়ে ওঠে।
    প্রস্থ  = 2.7
    উচ্চতা = সারি * প্রস্থ * 2.5 / স্তম্ভ
    মধ্য   = সারি / 2 + 1

    @ সারিক্রম:1..মধ্য {
        দর্পণ = সারি + 1 - সারিক্রম
        @ স্তম্ভক্রম:1..স্তম্ভ {
            বিন্দু_বাস্তব   = (স্তম্ভক্রম - 1) * প্রস্থ  / স্তম্ভ - 2.1
            বিন্দু_কাল্পনিক = (সারিক্রম - 1) * উচ্চতা / সারি - উচ্চতা / 2.0
            সহন           = পলায়ন(বিন্দু_বাস্তব, বিন্দু_কাল্পনিক)
            চিহ্ন          = "@"
            রং            = 231
            ? সহন <> 0 {
                ধাপ = সহন / 4 + 1
                ? ধাপ > 9 { ধাপ = 9 }
                চিহ্ন = ঢাল[ধাপ]
                রং   = রঙাবলি[ধাপ]
            }
            >>~ (সারিক্রম, স্তম্ভক্রম, 0, রং) > চিহ্ন
            ? দর্পণ > মধ্য { >>~ (দর্পণ, স্তম্ভক্রম, 0, রং) > চিহ্ন }
        }
    }

    >>~ (উঁচু, 2, 0, 244) > "বেরোতে যেকোনো চাবি চাপুন"
    <<| _চাবি
}
