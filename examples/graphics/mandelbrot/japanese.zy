// @skip-parity: 画布は CLI の下では本物の端末を、ブラウザでは画布の層を必要と
// @skip-parity: するので、パイプ越しの実行には比べる相手がない。
// ============================================================
// mandelbrot — マンデルブロ集合を、端末の画布に描く。
// 識別子は日本語。記号はいつでも記号のまま。
//
// すべてを決めるのは一つの数だ。`耐段`、軌道が発散するまでに
// 耐えた段の数。それが字形を選び、それが色を選ぶ。だから絵が
// 自分と食い違うことはない。`耐段 = 0` は一度も発散しなかったと
// いうこと — それが集合であり、詰まった字で描かれる。
//
//   >>|  画布を開く   >>!  消す   >>?  測る
//   >>~  一つの升を、行に、列に、一つの色で書く
//   <<|  キーを待つ
//
// 節約が二つ、どちらも計測ではなく絵に現れる。二乗は段から段へ
// 持ち回され、計算し直されない。そして集合は実軸のまわりに
// 鏡映されるので、発散するのは上半分だけになる。二つ合わせて、
// 細部が要求する解像度を購う。
// ============================================================

// 集合の外側 — 淡いものから詰まったものへ、暗い緑から明るい緑へ。
濃淡 = " .:-=+*#%"
色表 = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// 軌道が発散するまでに耐えた段の数。一度も発散しなければ 0。
// 軌実2 と 軌虚2 は持ち回されるので、一段の費用は積四つ、六つではない。
発散(点実, 点虚) {
    軌実  = 0.0
    軌虚  = 0.0
    軌実2 = 0.0
    軌虚2 = 0.0
    @ 周:1..36 {
        ? 軌実2 + 軌虚2 > 4.0 { <~ 周 }
        軌虚  = 2.0 * 軌実 * 軌虚 + 点虚
        軌実  = 軌実2 - 軌虚2 + 点実
        軌実2 = 軌実 * 軌実
        軌虚2 = 軌虚 * 軌虚
    }
    <~ 0
}

>>| {
    >>!
    (縦, 横) = >>?
    行 = 縦 - 2
    列 = 横 - 1

    // 升は幅より約 2.5 倍高いので、縦の幅をそれで割り付け、
    // 集合が丸く出るようにする。
    幅   = 2.7
    高さ = 行 * 幅 * 2.5 / 列
    中央 = 行 / 2 + 1

    @ 行番:1..中央 {
        鏡 = 行 + 1 - 行番
        @ 列番:1..列 {
            点実 = (列番 - 1) * 幅   / 列 - 2.1
            点虚 = (行番 - 1) * 高さ / 行 - 高さ / 2.0
            耐段 = 発散(点実, 点虚)
            記号 = "@"
            色   = 231
            ? 耐段 <> 0 {
                段 = 耐段 / 4 + 1
                ? 段 > 9 { 段 = 9 }
                記号 = 濃淡[段]
                色   = 色表[段]
            }
            >>~ (行番, 列番, 0, 色) > 記号
            ? 鏡 > 中央 { >>~ (鏡, 列番, 0, 色) > 記号 }
        }
    }

    >>~ (縦, 2, 0, 244) > "どれかキーを押すと終わります"
    <<| _キー
}
