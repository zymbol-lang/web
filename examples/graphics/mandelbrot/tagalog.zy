// @skip-parity: kailangan ng kanbas ang tunay na terminal sa ilalim ng CLI at
// @skip-parity: isang patong na kanbas sa pantingin, kaya ang pagpapatakbo sa
// @skip-parity: pamamagitan ng tubo ay walang maihahambing.
// ============================================================
// mandelbrot — ang tipon ng Mandelbrot, iginuhit sa kanbas ng terminal.
// Mga pangalan sa Tagalog. Ang mga tanda ay laging tanda.
//
// Isang bilang lamang ang nagpapasya ng lahat: `n`, ilang hakbang
// tinitiis ng landas bago ito makatakas. Ito ang pumipili ng titik
// at ito ang pumipili ng kulay, kaya hindi maaaring salungatin ng
// guhit ang sarili nito. `n = 0` ay nangangahulugang hindi ito
// kailanman nakatakas — iyon ang tipon, iginuhit nang puno.
//
//   >>|  binubuksan ang kanbas   >>!  binubura   >>?  sinusukat
//   >>~  sumusulat ng isang kahon, sa isang hanay, sa isang haligi, sa isang kulay
//   <<|  naghihintay ng isang pindutan
//
// Dalawang tipid, at pareho silang nakikita sa guhit at hindi sa
// isang pagsukat: dinadala ang mga parisukat mula sa isang hakbang
// tungo sa susunod sa halip na muling tuusin, at sinasalamin ang
// tipon sa palibot ng tunay na aksis, kaya ang itaas na kalahati
// lamang ang nakakatakas. Magkasama silang nagbabayad ng linaw na
// hinihingi ng detalye.
// ============================================================

// Sa labas ng tipon: mula malabo hanggang puno, mula madilim na luntian hanggang maliwanag.
dalisdis = " .:-=+*#%"
mgaKulay = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Mga hakbang na tinitiis bago makatakas ang landas; 0 kung hindi ito kailanman tumakas.
// Dinadala ang zr2 at zi2, kaya ang bawat hakbang ay apat na pagpaparami, hindi anim.
takas(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (taasTabing, luwangTabing) = >>?
    hanay  = taasTabing   - 2
    haligi = luwangTabing - 1

    // Ang isang kahon ay humigit-kumulang 2.5 beses na mas mataas kaysa
    // luwang; sinusukat nang ayon dito ang patayong saklaw upang
    // lumabas na bilog ang tipon.
    luwang = 2.7
    taas   = hanay * luwang * 2.5 / haligi
    gitna  = hanay / 2 + 1

    @ y:1..gitna {
        salamin = hanay + 1 - y
        @ x:1..haligi {
            cr = (x - 1) * luwang / haligi - 2.1
            ci = (y - 1) * taas   / hanay  - taas / 2.0
            n  = takas(cr, ci)
            tanda = "@"
            kulay = 231
            ? n <> 0 {
                hakbang = n / 4 + 1
                ? hakbang > 9 { hakbang = 9 }
                tanda = dalisdis[hakbang]
                kulay = mgaKulay[hakbang]
            }
            >>~ (y, x, 0, kulay) > tanda
            ? salamin > gitna { >>~ (salamin, x, 0, kulay) > tanda }
        }
    }

    >>~ (taasTabing, 2, 0, 244) > "pindutin ang alinmang pindutan upang lumabas"
    <<| _pindutan
}
