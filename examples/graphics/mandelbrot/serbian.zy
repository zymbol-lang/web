// @skip-parity: платну треба прави терминал под CLI-јем и слој платна у
// @skip-parity: прегледачу, па покретање кроз цев нема с чим да се пореди.
// ============================================================
// mandelbrot — Манделбротов скуп, нацртан на платну терминала.
// Имена на српском. Знаци увек остају знаци.
//
// Све одлучује један број: `n`, колико корака путања издржи пре
// него што побегне. Он бира знак и он бира боју, па цртеж не може
// сам себи да противречи. `n = 0` значи да никада није побегла —
// то је скуп, нацртан пуним знаком.
//
//   >>|  отвара платно   >>!  брише га   >>?  мери га
//   >>~  пише једну ћелију, у реду, у колони, једном бојом
//   <<|  чека тастер
//
// Две уштеде, и обе се виде на цртежу, а не у мерењу: квадрати се
// преносе с корака на корак уместо да се прерачунавају, а скуп се
// огледа око реалне осе, па бежи само горња половина. Заједно
// плаћају резолуцију коју појединост тражи.
// ============================================================

// Изван скупа: од бледог до пуног, од тамнозеленог до сјајног.
скала = " .:-=+*#%"
боје  = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Кораци издржани пре него што путања побегне; 0 ако не побегне никад.
// zr2 и zi2 се преносе, па сваки корак кошта четири производа, не шест.
бекство(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (високо, широко) = >>?
    редови = високо - 2
    колоне = широко - 1

    // Ћелија је око 2,5 пута виша него шира; усправни распон се
    // тиме скалира да скуп испадне округао.
    ширина  = 2.7
    висина  = редови * ширина * 2.5 / колоне
    средина = редови / 2 + 1

    @ y:1..средина {
        огледало = редови + 1 - y
        @ x:1..колоне {
            cr = (x - 1) * ширина / колоне - 2.1
            ci = (y - 1) * висина / редови - висина / 2.0
            n  = бекство(cr, ci)
            знак = "@"
            боја = 231
            ? n <> 0 {
                корак = n / 4 + 1
                ? корак > 9 { корак = 9 }
                знак = скала[корак]
                боја = боје[корак]
            }
            >>~ (y, x, 0, боја) > знак
            ? огледало > средина { >>~ (огледало, x, 0, боја) > знак }
        }
    }

    >>~ (високо, 2, 0, 244) > "било који тастер за излаз"
    <<| _тастер
}
