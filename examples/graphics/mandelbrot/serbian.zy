// @skip-parity: платну треба прави терминал под CLI-јем и слој платна у
// @skip-parity: прегледачу, па покретање кроз цев нема с чим да се пореди.
// ============================================================
// mandelbrot — Манделбротов скуп, нацртан на платну терминала.
// Имена на српском. Знаци увек остају знаци.
//
// Све одлучује један број: `издржљивост`, колико корака путања издржи пре
// него што побегне. Он бира знак и он бира боју, па цртеж не може
// сам себи да противречи. `издржљивост = 0` значи да никада није побегла —
// то је скуп, нацртан пуним знаком.
//
//   >>|  отвара платно   >>!  брише га   >>?  мери га
//   >>~  пише једну ћелију, у реду, у колони, једном бојом
//   <<|  чека тастер
//
// Две уштеде, и обе се виде на цртежу, а не у мерењу: квадрати се
// преносе с корака на корак уместо да се прерачунавају, а скуп се
// огледа око реалне осе, па бежи само горња половина. Заједно
// плаћају резолуцију коју појединост тражи.
// ============================================================

// Изван скупа: од бледог до пуног, од тамнозеленог до сјајног.
скала = " .:-=+*#%"
боје  = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Кораци издржани пре него што путања побегне; 0 ако не побегне никад.
// орбита_реал2 и орбита_имаг2 се преносе, па сваки корак кошта четири производа, не шест.
бекство(тачка_реал, тачка_имаг) {
    орбита_реал  = 0.0
    орбита_имаг  = 0.0
    орбита_реал2 = 0.0
    орбита_имаг2 = 0.0
    @ круг:1..36 {
        ? орбита_реал2 + орбита_имаг2 > 4.0 { <~ круг }
        орбита_имаг  = 2.0 * орбита_реал * орбита_имаг + тачка_имаг
        орбита_реал  = орбита_реал2 - орбита_имаг2 + тачка_реал
        орбита_реал2 = орбита_реал * орбита_реал
        орбита_имаг2 = орбита_имаг * орбита_имаг
    }
    <~ 0
}

>>| {
    >>!
    (високо, широко) = >>?
    редови = високо - 2
    колоне = широко - 1

    // Ћелија је око 2,5 пута виша него шира; усправни распон се
    // тиме скалира да скуп испадне округао.
    ширина  = 2.7
    висина  = редови * ширина * 2.5 / колоне
    средина = редови / 2 + 1

    @ ред:1..средина {
        огледало = редови + 1 - ред
        @ колона:1..колоне {
            тачка_реал  = (колона - 1) * ширина / колоне - 2.1
            тачка_имаг  = (ред    - 1) * висина / редови - висина / 2.0
            издржљивост = бекство(тачка_реал, тачка_имаг)
            знак        = "@"
            боја        = 231
            ? издржљивост <> 0 {
                корак = издржљивост / 4 + 1
                ? корак > 9 { корак = 9 }
                знак = скала[корак]
                боја = боје[корак]
            }
            >>~ (ред, колона, 0, боја) > знак
            ? огледало > средина { >>~ (огледало, колона, 0, боја) > знак }
        }
    }

    >>~ (високо, 2, 0, 244) > "било који тастер за излаз"
    <<| _тастер
}
