// @skip-parity: ᐆᒪ ᒪᓯᓇᐦᐃᑲᐣ ᐋᐧᐢᑲᐦᐃᑲᐣ ᑮᐢᐱᐣ ᑖᐺ terminal CLI ᐊᓴ, ᒥᓇ ᒪᓯᓇᐦᐃᑲᐣ
// @skip-parity: ᐋᐧᐢᑲᐦᐃᑲᐣ ᐊᓴ ᒥᓯᓇᐦᐃᑫᐏᐣ ᐋᐧᓴᑲᒥᐠ, ᐁᑯᓯ ᐯᔭᐠ ᐊᑑᐢᑫᐏᐣ ᓇᒨᔭ
// @skip-parity: ᑮᑿᔾ ᑳ ᓇᐢᐱᑕᐦᐊᐠ.
// ============================================================
// mandelbrot — ᐆᒪ Mandelbrot ᒫᒪᐏ, ᒪᓯᓇᐦᐃᑲᐣ ᐋᐧᐢᑲᐦᐃᑲᓂᕽ ᒪᓯᓇᐦᐊᒼ.
// ᐏᔦᐏᓇ ᓀᐦᐃᔭᐍᐏᐣ. ᒪᓯᓇᐦᐃᑲᓇᐢ ᑳᑭᑫ ᒪᓯᓇᐦᐃᑲᓇᐢ.
//
// ᐯᔭᐠ ᐊᑭᐦᑖᓱᐣ ᑳᑭᓇ ᑳ ᐅᑎᓇᐠ: `n`, ᑖᓂᒪᔭᑯᑊ ᐱᒧᐦᑌᐏᐣ ᐁ ᐱᒫᑎᓯᐟ
// ᐊᐢᑭᐦᑳᐣ ᐯᔭᑿᐤ ᐱᒥᐸᐦᑖᐤ. ᐏᔭ ᐅᑎᓇᒼ ᒪᓯᓇᐦᐃᑲᓇᐢ ᒥᓇ ᐅᑎᓇᒼ ᓇᐦᐄᔭᐏᐣ,
// ᐁᑯᓯ ᒪᓯᓇᐦᐃᑲᐣ ᓇᒨᔭ ᑮ ᐋᔭᒥᐦᐁᐤ ᐏᔭ. `n = 0` ᐃᑗᒪᑲᐣ ᓇᒨᔭ ᐍᐢᑲᐨ
// ᑮ ᐱᒥᐸᐦᑖᐤ — ᐁᐱᑯ ᐊᓇ ᒫᒪᐏ, ᐁ ᓵᑳᐢᑭᓀᐠ ᒪᓯᓇᐦᐊᒼ.
//
//   >>|  ᒪᓯᓇᐦᐃᑲᐣ ᐋᐧᐢᑲᐦᐃᑲᐣ ᔮᐦᑲᐦᐊᒼ   >>!  ᑳᓯᓇᒼ   >>?  ᑎᐱᐦᐊᒼ
//   >>~  ᐯᔭᐠ ᒥᐢᑭᓂᐢ ᒪᓯᓇᐦᐊᒼ, ᒪᓯᓇᐦᐃᑲᓂᐢ, ᓂᐹᐏᐣ, ᓇᐦᐄᔭᐏᐣ
//   <<|  ᐯᔭᐠ ᓵᑲᐦᐊᒼ ᐊᐢᑮᐤ
//
// ᓃᓱ ᐊᐢᑌᐤ, ᒥᓇ ᑖᐱᐢᑰᐨ ᒪᓯᓇᐦᐃᑲᓂᕽ ᐊᓴ ᓄᑯᓯᐤ, ᓇᒨᔭ ᑎᐱᐦᐃᑲᐣ ᐊᓴ:
// ᓀᐓ ᐊᐢᑌᐊᐧ ᐊᓄᐦᐨ ᐊᓯᐦᑖᐊᐧᐠ, ᓇᒨᔭ ᒦᓇ ᐊᑭᐦᑖᐊᐧᐠ, ᒥᓇ ᒫᒪᐏ ᐋᐧᐸᒧᐣ ᐊᓯᐦᑖᐤ
// ᑖᐺ ᒣᐢᑲᓇᐤ ᐊᓴ, ᐁᑯᓯ ᐃᐢᐱᒥᕽ ᑕᐢᑕᐋᐧᔨᕽ ᐱᑯ ᐱᒥᐸᐦᑖᐤ. ᒫᒪᐏ ᑎᐸᐦᐊᒷᐠ
// ᐋᐧᐸᐦᑎᐦᐃᐍᐏᐣ.
//
// ᐅᐢᑭ ᐏᔦᐏᓇ: ᒪᓯᓇᐦᐃᑲᓂᐢ (fila), ᓂᐹᐏᐣ (columna), ᓇᐦᐄᔭᐏᐣ (color),
// ᐱᒧᐦᑌᐏᐣ (paso), ᓵᑲᐦᐊᒼ (tecla), ᑭᓄᐋᐧᐤ ᒥᓇ ᐊᔭᐹᐤ ᐆᑕ ᐅᓯᐦᑖᐊᐧᐠ.
// ᓀᐦᐃᔭᐍᐏᐣ ᐁ ᐊᔭᒥᐦᐟ ᑲᑕ ᐋᐧᐸᐦᑕᒼ.
// ============================================================

// ᒫᒪᐏ ᐊᐧᔭᐍᔭᐢ: ᐋᐧᐸᐢᑫᔭᐤ ᐅᐦᒋ ᓵᑳᐢᑭᓀᐤ, ᑳᐢᑭᑌᐏᐢᑭᑌᐤ ᐅᐦᒋ ᐋᐧᐢᑌᐤ.
ᒪᓯᓇᐦᐃᑲᓇᐢ = " .:-=+*#%"
ᓇᐦᐄᔭᐏᓇ    = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// ᑖᓂᒪᔭᑯᑊ ᐱᒧᐦᑌᐏᐣ ᐁ ᐱᒫᑎᓯᐟ ᐊᐢᑭᐦᑳᐣ ᐱᒥᐸᐦᑖᐤ; 0 ᑮᐢᐱᐣ ᓇᒨᔭ ᐍᐢᑲᐨ.
// zr2 ᒥᓇ zi2 ᐊᓯᐦᑖᐊᐧᐠ, ᐁᑯᓯ ᐯᔭᐠ ᐱᒧᐦᑌᐏᐣ ᓀᐓ ᑎᐸᐦᐊᒼ, ᓇᒨᔭ ᓂᑯᑵᔭᓯᐠ.
ᐱᒥᐸᐦᑖᐤ(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (ᑭᓄᐋᐧᐤ, ᐊᔭᐹᐤ) = >>?
    ᒪᓯᓇᐦᐃᑲᓂᐢ = ᑭᓄᐋᐧᐤ - 2
    ᓂᐹᐏᐣ      = ᐊᔭᐹᐤ  - 1

    // ᐯᔭᐠ ᒥᐢᑭᓂᐢ ~2.5 ᐁ ᑭᓄᐋᐧᐠ ᐊᔭᐹᐤ ᐅᐦᒋ; ᐃᐢᐱᒥᕽ ᑎᐱᐦᐃᑲᐣ
    // ᐁᑯᓯ ᑎᐱᐦᐊᒼ ᒫᒪᐏ ᐁ ᐘᐘᔭᔮᐠ ᑕᐦᑭ.
    ᐊᔭᐹᐏᐣ = 2.7
    ᑭᓄᐋᐧᐏᐣ = ᒪᓯᓇᐦᐃᑲᓂᐢ * ᐊᔭᐹᐏᐣ * 2.5 / ᓂᐹᐏᐣ
    ᑕᐢᑕᐋᐧᔨᕽ = ᒪᓯᓇᐦᐃᑲᓂᐢ / 2 + 1

    @ y:1..ᑕᐢᑕᐋᐧᔨᕽ {
        ᐋᐧᐸᒧᐣ = ᒪᓯᓇᐦᐃᑲᓂᐢ + 1 - y
        @ x:1..ᓂᐹᐏᐣ {
            cr = (x - 1) * ᐊᔭᐹᐏᐣ  / ᓂᐹᐏᐣ      - 2.1
            ci = (y - 1) * ᑭᓄᐋᐧᐏᐣ / ᒪᓯᓇᐦᐃᑲᓂᐢ - ᑭᓄᐋᐧᐏᐣ / 2.0
            n  = ᐱᒥᐸᐦᑖᐤ(cr, ci)
            ᒪᓯᓇᐦᐃᑲᐣ = "@"
            ᓇᐦᐄᔭᐏᐣ   = 231
            ? n <> 0 {
                ᐱᒧᐦᑌᐏᐣ = n / 4 + 1
                ? ᐱᒧᐦᑌᐏᐣ > 9 { ᐱᒧᐦᑌᐏᐣ = 9 }
                ᒪᓯᓇᐦᐃᑲᐣ = ᒪᓯᓇᐦᐃᑲᓇᐢ[ᐱᒧᐦᑌᐏᐣ]
                ᓇᐦᐄᔭᐏᐣ   = ᓇᐦᐄᔭᐏᓇ[ᐱᒧᐦᑌᐏᐣ]
            }
            >>~ (y, x, 0, ᓇᐦᐄᔭᐏᐣ) > ᒪᓯᓇᐦᐃᑲᐣ
            ? ᐋᐧᐸᒧᐣ > ᑕᐢᑕᐋᐧᔨᕽ { >>~ (ᐋᐧᐸᒧᐣ, x, 0, ᓇᐦᐄᔭᐏᐣ) > ᒪᓯᓇᐦᐃᑲᐣ }
        }
    }

    >>~ (ᑭᓄᐋᐧᐤ, 2, 0, 244) > "ᐊᐍᓇ ᓵᑲᐦᐊᒼ ᓵᑲᐦᐊ ᑭᑕ ᐘᔭᐏᑎᒧᔭᐣ"
    <<| _ᓵᑲᐦᐊᒼ
}
