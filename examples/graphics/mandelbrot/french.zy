// @skip-parity: le canevas exige un vrai terminal sous la CLI et une couche de
// @skip-parity: canevas dans le navigateur : une exécution redirigée n'a donc
// @skip-parity: rien à comparer.
// ============================================================
// mandelbrot — l'ensemble de Mandelbrot, dessiné sur le canevas.
// Identificateurs en français. Opérateurs toujours symboliques.
//
// Un seul nombre décide de tout : `n`, le nombre de pas que l'orbite
// survit avant de s'échapper. Il choisit le glyphe et il choisit la
// couleur, donc le dessin ne peut pas se contredire. `n = 0` veut
// dire qu'elle ne s'est jamais échappée — c'est l'ensemble, plein.
//
//   >>|  ouvre le canevas   >>!  l'efface   >>?  le mesure
//   >>~  écrit une cellule, à une ligne, une colonne, d'une couleur
//   <<|  attend une touche
//
// Deux économies, et toutes deux se voient dans l'image plutôt que
// dans un banc d'essai : les carrés sont reportés d'une itération à
// l'autre au lieu d'être recalculés, et l'ensemble est mis en miroir
// autour de l'axe réel, si bien que seule la moitié haute s'échappe.
// Ensemble, elles paient la résolution que le détail réclame.
// ============================================================

// Hors de l'ensemble : du ténu au plein, du vert sombre au vif.
rampe   = " .:-=+*#%"
teintes = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Pas survécus avant que l'orbite s'échappe ; 0 si elle ne s'échappe jamais.
// zr2 et zi2 sont reportés : chaque pas coûte quatre produits, pas six.
échappement(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (haut, large) = >>?
    lignes   = haut  - 2
    colonnes = large - 1

    // Une cellule est ~2.5 fois plus haute que large ; l'étendue
    // verticale est mise à l'échelle pour que l'ensemble soit rond.
    largeur = 2.7
    hauteur = lignes * largeur * 2.5 / colonnes
    milieu  = lignes / 2 + 1

    @ y:1..milieu {
        miroir = lignes + 1 - y
        @ x:1..colonnes {
            cr = (x - 1) * largeur / colonnes - 2.1
            ci = (y - 1) * hauteur / lignes   - hauteur / 2.0
            n  = échappement(cr, ci)
            marque = "@"
            teinte = 231
            ? n <> 0 {
                pas = n / 4 + 1
                ? pas > 9 { pas = 9 }
                marque = rampe[pas]
                teinte = teintes[pas]
            }
            >>~ (y, x, 0, teinte) > marque
            ? miroir > milieu { >>~ (miroir, x, 0, teinte) > marque }
        }
    }

    >>~ (haut, 2, 0, 244) > "appuyez sur une touche pour quitter"
    <<| _touche
}
