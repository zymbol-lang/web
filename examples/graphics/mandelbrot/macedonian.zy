// @skip-parity: платното бара вистински терминал под CLI и слој платно во
// @skip-parity: прелистувачот, па пуштањето низ цевка нема со што да се спореди.
// ============================================================
// mandelbrot — Манделбротовото множество, нацртано на платното.
// Имиња на македонски. Знаците секогаш остануваат знаци.
//
// Сè решава еден број: `издржливост`, колку чекори патеката издржува пред
// да побегне. Тој го бира знакот и тој ја бира бојата, па цртежот
// не може да си противречи. `издржливост = 0` значи дека никогаш не побегна
// — тоа е множеството, нацртано полно.
//
//   >>|  го отвора платното   >>!  го чисти   >>?  го мери
//   >>~  пишува една ќелија, во ред, во колона, со една боја
//   <<|  чека копче
//
// Две заштеди, и двете се гледаат на цртежот, а не во мерење:
// квадратите се пренесуваат од чекор на чекор наместо да се
// пресметуваат одново, а множеството се огледува околу реалната
// оска, па бега само горната половина. Заедно ја плаќаат онаа
// разделивост што ја бара поединоста.
// ============================================================

// Надвор од множеството: од бледо до полно, од темнозелено до светло.
скала = " .:-=+*#%"
бои   = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Чекори издржани пред патеката да побегне; 0 ако не побегне никогаш.
// орбита_реал2 и орбита_имаг2 се пренесуваат, па секој чекор чини четири производи, не шест.
бегство(точка_реал, точка_имаг) {
    орбита_реал  = 0.0
    орбита_имаг  = 0.0
    орбита_реал2 = 0.0
    орбита_имаг2 = 0.0
    @ круг:1..36 {
        ? орбита_реал2 + орбита_имаг2 > 4.0 { <~ круг }
        орбита_имаг  = 2.0 * орбита_реал * орбита_имаг + точка_имаг
        орбита_реал  = орбита_реал2 - орбита_имаг2 + точка_реал
        орбита_реал2 = орбита_реал * орбита_реал
        орбита_имаг2 = орбита_имаг * орбита_имаг
    }
    <~ 0
}

>>| {
    >>!
    (високо, широко) = >>?
    редови = високо - 2
    колони = широко - 1

    // Ќелијата е околу 2,5 пати повисока отколку поширока; исправниот
    // распон се скалира со тоа за множеството да испадне тркалезно.
    ширина  = 2.7
    висина  = редови * ширина * 2.5 / колони
    средина = редови / 2 + 1

    @ ред:1..средина {
        огледало = редови + 1 - ред
        @ колона:1..колони {
            точка_реал  = (колона - 1) * ширина / колони - 2.1
            точка_имаг  = (ред    - 1) * висина / редови - висина / 2.0
            издржливост = бегство(точка_реал, точка_имаг)
            знак        = "@"
            боја        = 231
            ? издржливост <> 0 {
                чекор = издржливост / 4 + 1
                ? чекор > 9 { чекор = 9 }
                знак = скала[чекор]
                боја = бои[чекор]
            }
            >>~ (ред, колона, 0, боја) > знак
            ? огледало > средина { >>~ (огледало, колона, 0, боја) > знак }
        }
    }

    >>~ (високо, 2, 0, 244) > "кое било копче за излез"
    <<| _копче
}
