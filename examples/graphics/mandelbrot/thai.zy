// @skip-parity: ผืนผ้าต้องการเทอร์มินัลจริงใต้ CLI และชั้นผืนผ้าในเบราว์เซอร์
// @skip-parity: ฉะนั้นการรันผ่านท่อจึงไม่มีอะไรให้เทียบ
// ============================================================
// mandelbrot — เซตมันเดลบรอต วาดลงบนผืนผ้าของเทอร์มินัล
// ชื่อเป็นภาษาไทย เครื่องหมายยังคงเป็นเครื่องหมายเสมอ
//
// เลขจำนวนเดียวตัดสินทุกอย่าง: `ความทน` วงโคจรทนได้กี่ขั้นก่อนจะหนีไป
// มันเลือกรูปอักษรและมันเลือกสี ภาพจึงขัดแย้งกับตัวเองไม่ได้
// `ความทน = 0` หมายความว่ามันไม่เคยหนีเลย — นั่นคือเซต วาดเต็ม
//
//   >>|  เปิดผืนผ้า   >>!  ล้าง   >>?  วัด
//   >>~  เขียนหนึ่งช่อง ที่แถวหนึ่ง คอลัมน์หนึ่ง ด้วยสีหนึ่ง
//   <<|  รอปุ่ม
//
// การประหยัดสองอย่าง และทั้งสองปรากฏในภาพ ไม่ใช่ในการวัด:
// กำลังสองถูกพาไปจากขั้นหนึ่งสู่อีกขั้นแทนที่จะคำนวณใหม่
// และเซตถูกสะท้อนรอบแกนจริง ฉะนั้นจึงมีแต่ครึ่งบนที่หนี
// ทั้งสองรวมกันจ่ายค่าความละเอียดที่รายละเอียดเรียกร้อง
// ============================================================

// นอกเซต: จากจางไปเต็ม จากเขียวเข้มไปสว่าง
ไล่ระดับ   = " .:-=+*#%"
สีทั้งหลาย = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// ขั้นที่ทนได้ก่อนวงโคจรจะหนี; 0 ถ้ามันไม่เคยหนี
// วง_จริง2 และ วง_จินตภาพ2 ถูกพาไปด้วย แต่ละขั้นจึงเสียการคูณสี่ครั้ง ไม่ใช่หก
หนี(จุด_จริง, จุด_จินตภาพ) {
    วง_จริง     = 0.0
    วง_จินตภาพ  = 0.0
    วง_จริง2    = 0.0
    วง_จินตภาพ2 = 0.0
    @ รอบ:1..36 {
        ? วง_จริง2 + วง_จินตภาพ2 > 4.0 { <~ รอบ }
        วง_จินตภาพ  = 2.0 * วง_จริง * วง_จินตภาพ + จุด_จินตภาพ
        วง_จริง     = วง_จริง2 - วง_จินตภาพ2 + จุด_จริง
        วง_จริง2    = วง_จริง * วง_จริง
        วง_จินตภาพ2 = วง_จินตภาพ * วง_จินตภาพ
    }
    <~ 0
}

>>| {
    >>!
    (สูง, กว้าง) = >>?
    แถว     = สูง   - 2
    คอลัมน์ = กว้าง - 1

    // หนึ่งช่องสูงกว่ากว้างราว 2.5 เท่า ช่วงแนวตั้งจึงถูกย่อ
    // ตามนั้นเพื่อให้เซตออกมากลม
    ความกว้าง = 2.7
    ความสูง   = แถว * ความกว้าง * 2.5 / คอลัมน์
    กลาง     = แถว / 2 + 1

    @ แถวที่:1..กลาง {
        กระจก = แถว + 1 - แถวที่
        @ คอลัมน์ที่:1..คอลัมน์ {
            จุด_จริง    = (คอลัมน์ที่ - 1) * ความกว้าง / คอลัมน์ - 2.1
            จุด_จินตภาพ = (แถวที่     - 1) * ความสูง   / แถว     - ความสูง / 2.0
            ความทน     = หนี(จุด_จริง, จุด_จินตภาพ)
            เครื่องหมาย = "@"
            สี         = 231
            ? ความทน <> 0 {
                ขั้น = ความทน / 4 + 1
                ? ขั้น > 9 { ขั้น = 9 }
                เครื่องหมาย = ไล่ระดับ[ขั้น]
                สี         = สีทั้งหลาย[ขั้น]
            }
            >>~ (แถวที่, คอลัมน์ที่, 0, สี) > เครื่องหมาย
            ? กระจก > กลาง { >>~ (กระจก, คอลัมน์ที่, 0, สี) > เครื่องหมาย }
        }
    }

    >>~ (สูง, 2, 0, 244) > "กดปุ่มใดก็ได้เพื่อออก"
    <<| _ปุ่ม
}
