// @skip-parity: 画布在 CLI 下需要真正的终端，在浏览器里需要画布层，
// @skip-parity: 所以通过管道运行时没有可比较的东西。
// ============================================================
// mandelbrot — 曼德博集合，画在终端的画布上。
// 标识符用中文。记号始终是记号。
//
// 一个数决定一切：`n`，轨道在逃逸之前熬过的步数。它挑字形，
// 它也挑颜色，所以画面不会自相矛盾。`n = 0` 表示它从未逃逸 —
// 那就是集合本身，画得饱满。
//
//   >>|  打开画布   >>!  清空   >>?  量取
//   >>~  写一个格子，在某行，某列，用某个颜色
//   <<|  等一个按键
//
// 两处省法，两处都显在画面上而不在测量里：平方从一步带到下一步
// 而不重算，集合沿实轴镜像，所以只有上半会逃逸。两者合起来，
// 买下细节所要的分辨率。
// ============================================================

// 集合之外：由淡到满，由深绿到明亮。
灰阶   = " .:-=+*#%"
颜色表 = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// 轨道逃逸之前熬过的步数；若从不逃逸则为 0。
// zr2 与 zi2 被带着走，所以每一步只花四次乘法，而不是六次。
逃逸(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (高, 宽) = >>?
    行 = 高 - 2
    列 = 宽 - 1

    // 一个格子约比它的宽高出 2.5 倍；竖向的跨度按此缩放，
    // 好让集合出来是圆的。
    宽度 = 2.7
    高度 = 行 * 宽度 * 2.5 / 列
    中间 = 行 / 2 + 1

    @ y:1..中间 {
        镜像 = 行 + 1 - y
        @ x:1..列 {
            cr = (x - 1) * 宽度 / 列 - 2.1
            ci = (y - 1) * 高度 / 行 - 高度 / 2.0
            n  = 逃逸(cr, ci)
            记号 = "@"
            颜色 = 231
            ? n <> 0 {
                步 = n / 4 + 1
                ? 步 > 9 { 步 = 9 }
                记号 = 灰阶[步]
                颜色 = 颜色表[步]
            }
            >>~ (y, x, 0, 颜色) > 记号
            ? 镜像 > 中间 { >>~ (镜像, x, 0, 颜色) > 记号 }
        }
    }

    >>~ (高, 2, 0, 244) > "按任意键离开"
    <<| _按键
}
