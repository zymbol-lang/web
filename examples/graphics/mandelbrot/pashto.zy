// @skip-parity: پرده د کمانډ لاین لاندې ریښتیني ټرمینل او په براوزر کې د پردې یوې
// @skip-parity: طبقې ته اړتیا لري، نو د پایپ له لارې چلول د پرتلې لپاره څه نه پریږدي.
// ============================================================
// mandelbrot — د مانډلبرو ټولګه، د ټرمینل پر پرده انځور شوې.
// نومونه په پښتو. نښې تل نښې پاتې کیږي.
//
// یو شمېر هر څه ټاکي: ‏`زغم`‏، مدار د تېښتې دمخه څو ګامه زغمي. هغه دی
// چې توری ټاکي، او هغه دی چې رنګ ټاکي؛ نو انځور نشي کولی له ځان
// سره مخالفت وکړي. ‏`زغم = ۰`‏ یعنې هېڅکله ونه تښتېد — دا پخپله همغه
// ټولګه ده، ډکه انځور شوې.
//
//   >>|  پرده پرانیزي   >>!  پاکوي   >>?  اندازه کوي
//   >>~  یوه خانه لیکي، په یوه کتار کې، یوه ستنه، په یوه رنګ
//   <<|  د یوې کیلي انتظار باسي
//
// دوه سپما، او دواړه په انځور کې لیدل کیږي نه په اندازه کې: مربعات
// له یوه ګام څخه بل ته وړل کیږي پر ځای د دې چې بیا وشمېرل شي، او
// ټولګه د ریښتیني محور شاوخوا په هنداره کې ښودل کیږي، نو یوازې
// پورتنۍ نیمایي تښتي. دواړه یوځای هغه رڼاوالی پیري چې تفصیل یې غواړي.
// ============================================================

// له ټولګې بهر: له کمرنګه څخه تر ډک، له تیاره شنه څخه تر روښانه.
نښې    = " .:-=+*#%"
رنګونه = [۲۲, ۲۸, ۳۴, ۴۰, ۴۶, ۸۲, ۱۱۸, ۱۵۴, ۱۹۱]

// هغه ګامونه چې مدار یې د تېښتې دمخه وزغمل؛ که هېڅکله ونه تښتېد نو صفر.
// مدار_حقيقي۲ او مدار_خيالي۲ هم وړل کیږي، نو هر ګام څلور ضربې لګښت لري، شپږ نه.
تښتېدل(ټکی_حقيقي, ټکی_خيالي) {
    مدار_حقيقي  = ۰.۰
    مدار_خيالي  = ۰.۰
    مدار_حقيقي۲ = ۰.۰
    مدار_خيالي۲ = ۰.۰
    @ دوره:۱..۳۶ {
        ? مدار_حقيقي۲ + مدار_خيالي۲ > ۴.۰ { <~ دوره }
        مدار_خيالي  = ۲.۰ * مدار_حقيقي * مدار_خيالي + ټکی_خيالي
        مدار_حقيقي  = مدار_حقيقي۲ - مدار_خيالي۲ + ټکی_حقيقي
        مدار_حقيقي۲ = مدار_حقيقي * مدار_حقيقي
        مدار_خيالي۲ = مدار_خيالي * مدار_خيالي
    }
    <~ ۰
}

>>| {
    >>!
    (لوړوالی, پلنوالی) = >>?
    کتارونه = لوړوالی  - ۲
    ستنې    = پلنوالی - ۱

    // یوه خانه له خپل پلنوالي څخه شاوخوا ۲.۵ ځله لوړه ده؛ عمودي
    // پراخوالی په همدې اندازه کیږي څو ټولګه ګرده راووځي.
    پلنوالی_ډګر = ۲.۷
    لوړوالی_ډګر = کتارونه * پلنوالی_ډګر * ۲.۵ / ستنې
    منځ         = کتارونه / ۲ + ۱

    @ کتار:۱..منځ {
        هنداره = کتارونه + ۱ - کتار
        @ ستنه:۱..ستنې {
            ټکی_حقيقي = (ستنه - ۱) * پلنوالی_ډګر / ستنې    - ۲.۱
            ټکی_خيالي = (کتار - ۱) * لوړوالی_ډګر / کتارونه - لوړوالی_ډګر / ۲.۰
            زغم       = تښتېدل(ټکی_حقيقي, ټکی_خيالي)
            نښه       = "@"
            رنګ       = ۲۳۱
            ? زغم <> ۰ {
                ګام = زغم / ۴ + ۱
                ? ګام > ۹ { ګام = ۹ }
                نښه = نښې[ګام]
                رنګ = رنګونه[ګام]
            }
            >>~ (کتار, ستنه, ۰, رنګ) > نښه
            ? هنداره > منځ { >>~ (هنداره, ستنه, ۰, رنګ) > نښه }
        }
    }

    >>~ (لوړوالی, ۲, ۰, ۲۴۴) > "د وتلو لپاره هره کیلي کېښکاږئ"
    <<| _کیلي
}
