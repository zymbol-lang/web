// @skip-parity: پرده د کمانډ لاین لاندې ریښتیني ټرمینل او په براوزر کې د پردې یوې
// @skip-parity: طبقې ته اړتیا لري، نو د پایپ له لارې چلول د پرتلې لپاره څه نه پریږدي.
// ============================================================
// mandelbrot — د مانډلبرو ټولګه، د ټرمینل پر پرده انځور شوې.
// نومونه په پښتو. نښې تل نښې پاتې کیږي.
//
// یو شمېر هر څه ټاکي: ‏`n`‏، مدار د تېښتې دمخه څو ګامه زغمي. هغه دی
// چې توری ټاکي، او هغه دی چې رنګ ټاکي؛ نو انځور نشي کولی له ځان
// سره مخالفت وکړي. ‏`n = 0`‏ یعنې هېڅکله ونه تښتېد — دا پخپله همغه
// ټولګه ده، ډکه انځور شوې.
//
//   >>|  پرده پرانیزي   >>!  پاکوي   >>?  اندازه کوي
//   >>~  یوه خانه لیکي، په یوه کتار کې، یوه ستنه، په یوه رنګ
//   <<|  د یوې کیلي انتظار باسي
//
// دوه سپما، او دواړه په انځور کې لیدل کیږي نه په اندازه کې: مربعات
// له یوه ګام څخه بل ته وړل کیږي پر ځای د دې چې بیا وشمېرل شي، او
// ټولګه د ریښتیني محور شاوخوا په هنداره کې ښودل کیږي، نو یوازې
// پورتنۍ نیمایي تښتي. دواړه یوځای هغه رڼاوالی پیري چې تفصیل یې غواړي.
// ============================================================

// له ټولګې بهر: له کمرنګه څخه تر ډک، له تیاره شنه څخه تر روښانه.
نښې     = " .:-=+*#%"
رنګونه = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// هغه ګامونه چې مدار یې د تېښتې دمخه وزغمل؛ که هېڅکله ونه تښتېد نو صفر.
// zr2 او zi2 هم وړل کیږي، نو هر ګام څلور ضربې لګښت لري، شپږ نه.
تښتېدل(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (لوړوالی, پلنوالی) = >>?
    کتارونه = لوړوالی  - 2
    ستنې     = پلنوالی - 1

    // یوه خانه له خپل پلنوالي څخه شاوخوا 2.5 ځله لوړه ده؛ عمودي
    // پراخوالی په همدې اندازه کیږي څو ټولګه ګرده راووځي.
    پلنوالی_ډګر = 2.7
    لوړوالی_ډګر = کتارونه * پلنوالی_ډګر * 2.5 / ستنې
    منځ          = کتارونه / 2 + 1

    @ y:1..منځ {
        هنداره = کتارونه + 1 - y
        @ x:1..ستنې {
            cr = (x - 1) * پلنوالی_ډګر / ستنې    - 2.1
            ci = (y - 1) * لوړوالی_ډګر / کتارونه - لوړوالی_ډګر / 2.0
            n  = تښتېدل(cr, ci)
            نښه = "@"
            رنګ = 231
            ? n <> 0 {
                ګام = n / 4 + 1
                ? ګام > 9 { ګام = 9 }
                نښه = نښې[ګام]
                رنګ = رنګونه[ګام]
            }
            >>~ (y, x, 0, رنګ) > نښه
            ? هنداره > منځ { >>~ (هنداره, x, 0, رنګ) > نښه }
        }
    }

    >>~ (لوړوالی, 2, 0, 244) > "د وتلو لپاره هره کیلي کېښکاږئ"
    <<| _کیلي
}
