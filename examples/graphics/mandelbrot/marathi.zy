// @skip-parity: पटलाला CLI खाली खरा टर्मिनल लागतो आणि ब्राउझरमध्ये पटलाचा एक
// @skip-parity: थर लागतो, म्हणून नळीतून चालवल्यास तुलना करायला काही उरत नाही.
// ============================================================
// mandelbrot — मांडेलब्रोट संच, टर्मिनलच्या पटलावर काढलेला.
// नावे मराठीत. खुणा नेहमी खुणाच राहतात.
//
// सारे एकाच संख्येवर ठरते: `सहनशक्ती`, कक्षा पळून जाण्याआधी किती पावले
// टिकते. तीच अक्षर निवडते आणि तीच रंग निवडते, म्हणून चित्र स्वतःशी
// विसंगत होऊ शकत नाही. `सहनशक्ती = 0` म्हणजे ती कधीच पळाली नाही — तोच
// संच, भरून काढलेला.
//
//   >>|  पटल उघडते   >>!  पुसते   >>?  मोजते
//   >>~  एक खण लिहिते, एका ओळीत, एका स्तंभात, एका रंगात
//   <<|  एका कळीची वाट पाहते
//
// दोन बचती, आणि दोन्ही मापात नव्हे तर चित्रातच दिसतात: वर्ग एका
// पावलापासून पुढच्यापर्यंत वाहून नेले जातात, पुन्हा मोजले जात नाहीत,
// आणि संच वास्तव अक्षाभोवती आरशासारखा उमटतो, म्हणून वरचा अर्धाच
// पळतो. दोन्ही मिळून तपशील मागतो ती स्पष्टता विकत घेतात.
// ============================================================

// संचाबाहेर: फिकटापासून भरलेल्यापर्यंत, गडद हिरव्यापासून तेजस्वीपर्यंत.
उतार    = " .:-=+*#%"
रंगावली = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// कक्षा पळण्याआधी टिकलेली पावले; कधीच न पळाल्यास ०.
// कक्षा_वास्तव2 आणि कक्षा_काल्पनिक2 वाहून नेले जातात, म्हणून प्रत्येक पाऊल चार गुणाकार मागते, सहा नव्हे.
पलायन(बिंदू_वास्तव, बिंदू_काल्पनिक) {
    कक्षा_वास्तव    = 0.0
    कक्षा_काल्पनिक  = 0.0
    कक्षा_वास्तव2   = 0.0
    कक्षा_काल्पनिक2 = 0.0
    @ फेरा:1..36 {
        ? कक्षा_वास्तव2 + कक्षा_काल्पनिक2 > 4.0 { <~ फेरा }
        कक्षा_काल्पनिक  = 2.0 * कक्षा_वास्तव * कक्षा_काल्पनिक + बिंदू_काल्पनिक
        कक्षा_वास्तव    = कक्षा_वास्तव2 - कक्षा_काल्पनिक2 + बिंदू_वास्तव
        कक्षा_वास्तव2   = कक्षा_वास्तव * कक्षा_वास्तव
        कक्षा_काल्पनिक2 = कक्षा_काल्पनिक * कक्षा_काल्पनिक
    }
    <~ 0
}

>>| {
    >>!
    (उंच, रुंद) = >>?
    ओळी  = उंच  - 2
    स्तंभ = रुंद - 1

    // एक खण त्याच्या रुंदीपेक्षा सुमारे २.५ पट उंच आहे; उभा पल्ला
    // त्यानेच मोजला जातो, म्हणजे संच गोल निघावा.
    रुंदी = 2.7
    उंची  = ओळी * रुंदी * 2.5 / स्तंभ
    मध्य   = ओळी / 2 + 1

    @ ओळक्रम:1..मध्य {
        आरसा = ओळी + 1 - ओळक्रम
        @ स्तंभक्रम:1..स्तंभ {
            बिंदू_वास्तव   = (स्तंभक्रम - 1) * रुंदी / स्तंभ - 2.1
            बिंदू_काल्पनिक = (ओळक्रम   - 1) * उंची  / ओळी  - उंची / 2.0
            सहनशक्ती       = पलायन(बिंदू_वास्तव, बिंदू_काल्पनिक)
            खूण           = "@"
            रंग           = 231
            ? सहनशक्ती <> 0 {
                पाऊल = सहनशक्ती / 4 + 1
                ? पाऊल > 9 { पाऊल = 9 }
                खूण = उतार[पाऊल]
                रंग = रंगावली[पाऊल]
            }
            >>~ (ओळक्रम, स्तंभक्रम, 0, रंग) > खूण
            ? आरसा > मध्य { >>~ (आरसा, स्तंभक्रम, 0, रंग) > खूण }
        }
    }

    >>~ (उंच, 2, 0, 244) > "बाहेर पडण्यासाठी कोणतीही कळ दाबा"
    <<| _कळ
}
