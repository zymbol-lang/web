// @skip-parity: पटलाला CLI खाली खरा टर्मिनल लागतो आणि ब्राउझरमध्ये पटलाचा एक
// @skip-parity: थर लागतो, म्हणून नळीतून चालवल्यास तुलना करायला काही उरत नाही.
// ============================================================
// mandelbrot — मांडेलब्रोट संच, टर्मिनलच्या पटलावर काढलेला.
// नावे मराठीत. खुणा नेहमी खुणाच राहतात.
//
// सारे एकाच संख्येवर ठरते: `n`, कक्षा पळून जाण्याआधी किती पावले
// टिकते. तीच अक्षर निवडते आणि तीच रंग निवडते, म्हणून चित्र स्वतःशी
// विसंगत होऊ शकत नाही. `n = 0` म्हणजे ती कधीच पळाली नाही — तोच
// संच, भरून काढलेला.
//
//   >>|  पटल उघडते   >>!  पुसते   >>?  मोजते
//   >>~  एक खण लिहिते, एका ओळीत, एका स्तंभात, एका रंगात
//   <<|  एका कळीची वाट पाहते
//
// दोन बचती, आणि दोन्ही मापात नव्हे तर चित्रातच दिसतात: वर्ग एका
// पावलापासून पुढच्यापर्यंत वाहून नेले जातात, पुन्हा मोजले जात नाहीत,
// आणि संच वास्तव अक्षाभोवती आरशासारखा उमटतो, म्हणून वरचा अर्धाच
// पळतो. दोन्ही मिळून तपशील मागतो ती स्पष्टता विकत घेतात.
// ============================================================

// संचाबाहेर: फिकटापासून भरलेल्यापर्यंत, गडद हिरव्यापासून तेजस्वीपर्यंत.
उतार    = " .:-=+*#%"
रंगावली = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// कक्षा पळण्याआधी टिकलेली पावले; कधीच न पळाल्यास ०.
// zr2 आणि zi2 वाहून नेले जातात, म्हणून प्रत्येक पाऊल चार गुणाकार मागते, सहा नव्हे.
पलायन(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (उंच, रुंद) = >>?
    ओळी   = उंच  - 2
    स्तंभ = रुंद - 1

    // एक खण त्याच्या रुंदीपेक्षा सुमारे २.५ पट उंच आहे; उभा पल्ला
    // त्यानेच मोजला जातो, म्हणजे संच गोल निघावा.
    रुंदी = 2.7
    उंची  = ओळी * रुंदी * 2.5 / स्तंभ
    मध्य  = ओळी / 2 + 1

    @ y:1..मध्य {
        आरसा = ओळी + 1 - y
        @ x:1..स्तंभ {
            cr = (x - 1) * रुंदी / स्तंभ - 2.1
            ci = (y - 1) * उंची  / ओळी   - उंची / 2.0
            n  = पलायन(cr, ci)
            खूण = "@"
            रंग = 231
            ? n <> 0 {
                पाऊल = n / 4 + 1
                ? पाऊल > 9 { पाऊल = 9 }
                खूण = उतार[पाऊल]
                रंग = रंगावली[पाऊल]
            }
            >>~ (y, x, 0, रंग) > खूण
            ? आरसा > मध्य { >>~ (आरसा, x, 0, रंग) > खूण }
        }
    }

    >>~ (उंच, 2, 0, 244) > "बाहेर पडण्यासाठी कोणतीही कळ दाबा"
    <<| _कळ
}
