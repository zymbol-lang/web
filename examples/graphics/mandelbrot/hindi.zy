// @skip-parity: पटल को CLI के नीचे असली टर्मिनल चाहिए और ब्राउज़र में पटल की
// @skip-parity: एक परत, इसलिए नली से चलाने पर तुलना करने को कुछ नहीं बचता।
// ============================================================
// mandelbrot — मंडेलब्रोट समुच्चय, टर्मिनल के पटल पर बनाया गया।
// नाम हिन्दी में। चिह्न सदा चिह्न ही रहते हैं।
//
// सब कुछ एक ही संख्या तय करती है: `सहनशक्ति`, कक्षा पलायन से पहले कितने
// चरण सह लेती है। वही अक्षर चुनती है और वही रंग चुनती है, इसलिए
// चित्र स्वयं का खंडन नहीं कर सकता। `सहनशक्ति = ०` का अर्थ है कि वह कभी
// पलायन नहीं हुई — वही समुच्चय है, भरा हुआ बना।
//
//   >>|  पटल खोलता है   >>!  मिटाता है   >>?  नापता है
//   >>~  एक खाना लिखता है, एक पंक्ति में, एक स्तंभ में, एक रंग से
//   <<|  एक कुंजी की प्रतीक्षा करता है
//
// दो बचत, और दोनों माप में नहीं, चित्र में दिखती हैं: वर्ग एक चरण से
// अगले तक साथ ले जाए जाते हैं, फिर से नहीं गिने जाते, और समुच्चय
// वास्तविक अक्ष के चारों ओर दर्पणित होता है, इसलिए केवल ऊपरी आधा
// पलायन करता है। दोनों मिलकर वह विभेदन चुकाते हैं जो ब्योरा माँगता है।
// ============================================================

// समुच्चय के बाहर: फीके से भरे तक, गहरे हरे से चमकीले तक।
ढाल     = " .:-=+*#%"
रंगावली = [२२, २८, ३४, ४०, ४६, ८२, ११८, १५४, १९१]

// कक्षा के पलायन से पहले सहे गए चरण; यदि वह कभी पलायन न करे तो ०।
// कक्षा_वास्तव२ और कक्षा_काल्पनिक२ साथ ले जाए जाते हैं, इसलिए हर चरण चार गुणा माँगता है, छह नहीं।
पलायन(बिंदु_वास्तव, बिंदु_काल्पनिक) {
    कक्षा_वास्तव    = ०.०
    कक्षा_काल्पनिक  = ०.०
    कक्षा_वास्तव२   = ०.०
    कक्षा_काल्पनिक२ = ०.०
    @ फेरा:१..३६ {
        ? कक्षा_वास्तव२ + कक्षा_काल्पनिक२ > ४.० { <~ फेरा }
        कक्षा_काल्पनिक  = २.० * कक्षा_वास्तव * कक्षा_काल्पनिक + बिंदु_काल्पनिक
        कक्षा_वास्तव    = कक्षा_वास्तव२ - कक्षा_काल्पनिक२ + बिंदु_वास्तव
        कक्षा_वास्तव२   = कक्षा_वास्तव * कक्षा_वास्तव
        कक्षा_काल्पनिक२ = कक्षा_काल्पनिक * कक्षा_काल्पनिक
    }
    <~ ०
}

>>| {
    >>!
    (ऊँचा, चौड़ा) = >>?
    पंक्तियाँ = ऊँचा  - २
    स्तंभ     = चौड़ा - १

    // एक खाना अपनी चौड़ाई से लगभग २.५ गुना ऊँचा है; खड़ा फैलाव
    // उसी से नापा जाता है ताकि समुच्चय गोल निकले।
    चौड़ाई = २.७
    ऊँचाई = पंक्तियाँ * चौड़ाई * २.५ / स्तंभ
    मध्य   = पंक्तियाँ / २ + १

    @ पंक्तिक्रम:१..मध्य {
        दर्पण = पंक्तियाँ + १ - पंक्तिक्रम
        @ स्तंभक्रम:१..स्तंभ {
            बिंदु_वास्तव   = (स्तंभक्रम  - १) * चौड़ाई / स्तंभ     - २.१
            बिंदु_काल्पनिक = (पंक्तिक्रम - १) * ऊँचाई / पंक्तियाँ - ऊँचाई / २.०
            सहनशक्ति       = पलायन(बिंदु_वास्तव, बिंदु_काल्पनिक)
            चिह्न          = "@"
            रंग           = २३१
            ? सहनशक्ति <> ० {
                चरण = सहनशक्ति / ४ + १
                ? चरण > ९ { चरण = ९ }
                चिह्न = ढाल[चरण]
                रंग  = रंगावली[चरण]
            }
            >>~ (पंक्तिक्रम, स्तंभक्रम, ०, रंग) > चिह्न
            ? दर्पण > मध्य { >>~ (दर्पण, स्तंभक्रम, ०, रंग) > चिह्न }
        }
    }

    >>~ (ऊँचा, २, ०, २४४) > "निकलने के लिए कोई भी कुंजी दबाएँ"
    <<| _कुंजी
}
