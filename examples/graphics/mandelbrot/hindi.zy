// @skip-parity: पटल को CLI के नीचे असली टर्मिनल चाहिए और ब्राउज़र में पटल की
// @skip-parity: एक परत, इसलिए नली से चलाने पर तुलना करने को कुछ नहीं बचता।
// ============================================================
// mandelbrot — मंडेलब्रोट समुच्चय, टर्मिनल के पटल पर बनाया गया।
// नाम हिन्दी में। चिह्न सदा चिह्न ही रहते हैं।
//
// सब कुछ एक ही संख्या तय करती है: `सहनशक्ति`, कक्षा पलायन से पहले कितने
// चरण सह लेती है। वही अक्षर चुनती है और वही रंग चुनती है, इसलिए
// चित्र स्वयं का खंडन नहीं कर सकता। `सहनशक्ति = 0` का अर्थ है कि वह कभी
// पलायन नहीं हुई — वही समुच्चय है, भरा हुआ बना।
//
//   >>|  पटल खोलता है   >>!  मिटाता है   >>?  नापता है
//   >>~  एक खाना लिखता है, एक पंक्ति में, एक स्तंभ में, एक रंग से
//   <<|  एक कुंजी की प्रतीक्षा करता है
//
// दो बचत, और दोनों माप में नहीं, चित्र में दिखती हैं: वर्ग एक चरण से
// अगले तक साथ ले जाए जाते हैं, फिर से नहीं गिने जाते, और समुच्चय
// वास्तविक अक्ष के चारों ओर दर्पणित होता है, इसलिए केवल ऊपरी आधा
// पलायन करता है। दोनों मिलकर वह विभेदन चुकाते हैं जो ब्योरा माँगता है।
// ============================================================

// समुच्चय के बाहर: फीके से भरे तक, गहरे हरे से चमकीले तक।
ढाल     = " .:-=+*#%"
रंगावली = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// कक्षा के पलायन से पहले सहे गए चरण; यदि वह कभी पलायन न करे तो 0।
// कक्षा_वास्तव2 और कक्षा_काल्पनिक2 साथ ले जाए जाते हैं, इसलिए हर चरण चार गुणा माँगता है, छह नहीं।
पलायन(बिंदु_वास्तव, बिंदु_काल्पनिक) {
    कक्षा_वास्तव    = 0.0
    कक्षा_काल्पनिक  = 0.0
    कक्षा_वास्तव2   = 0.0
    कक्षा_काल्पनिक2 = 0.0
    @ फेरा:1..36 {
        ? कक्षा_वास्तव2 + कक्षा_काल्पनिक2 > 4.0 { <~ फेरा }
        कक्षा_काल्पनिक  = 2.0 * कक्षा_वास्तव * कक्षा_काल्पनिक + बिंदु_काल्पनिक
        कक्षा_वास्तव    = कक्षा_वास्तव2 - कक्षा_काल्पनिक2 + बिंदु_वास्तव
        कक्षा_वास्तव2   = कक्षा_वास्तव * कक्षा_वास्तव
        कक्षा_काल्पनिक2 = कक्षा_काल्पनिक * कक्षा_काल्पनिक
    }
    <~ 0
}

>>| {
    >>!
    (ऊँचा, चौड़ा) = >>?
    पंक्तियाँ = ऊँचा  - 2
    स्तंभ     = चौड़ा - 1

    // एक खाना अपनी चौड़ाई से लगभग 2.5 गुना ऊँचा है; खड़ा फैलाव
    // उसी से नापा जाता है ताकि समुच्चय गोल निकले।
    चौड़ाई = 2.7
    ऊँचाई = पंक्तियाँ * चौड़ाई * 2.5 / स्तंभ
    मध्य   = पंक्तियाँ / 2 + 1

    @ पंक्तिक्रम:1..मध्य {
        दर्पण = पंक्तियाँ + 1 - पंक्तिक्रम
        @ स्तंभक्रम:1..स्तंभ {
            बिंदु_वास्तव   = (स्तंभक्रम  - 1) * चौड़ाई / स्तंभ     - 2.1
            बिंदु_काल्पनिक = (पंक्तिक्रम - 1) * ऊँचाई / पंक्तियाँ - ऊँचाई / 2.0
            सहनशक्ति       = पलायन(बिंदु_वास्तव, बिंदु_काल्पनिक)
            चिह्न          = "@"
            रंग           = 231
            ? सहनशक्ति <> 0 {
                चरण = सहनशक्ति / 4 + 1
                ? चरण > 9 { चरण = 9 }
                चिह्न = ढाल[चरण]
                रंग  = रंगावली[चरण]
            }
            >>~ (पंक्तिक्रम, स्तंभक्रम, 0, रंग) > चिह्न
            ? दर्पण > मध्य { >>~ (दर्पण, स्तंभक्रम, 0, रंग) > चिह्न }
        }
    }

    >>~ (ऊँचा, 2, 0, 244) > "निकलने के लिए कोई भी कुंजी दबाएँ"
    <<| _कुंजी
}
