// @skip-parity: पर्दालाई CLI मुनि साँच्चैको टर्मिनल चाहिन्छ र ब्राउजरमा पर्दाको
// @skip-parity: एउटा तह चाहिन्छ, त्यसैले नलीबाट चलाउँदा तुलना गर्न केही रहँदैन।
// ============================================================
// mandelbrot — मान्डेलब्रोट समुच्चय, टर्मिनलको पर्दामा कोरिएको।
// नाम नेपालीमा। चिन्हहरू सधैँ चिन्ह नै रहन्छन्।
//
// सबै कुरा एउटै सङ्ख्याले निर्णय गर्छ: `सहनशक्ति`, कक्ष भाग्नुअघि कति
// पाइला थाम्छ। त्यसैले अक्षर छान्छ र त्यसैले रङ छान्छ, त्यसैले चित्रले
// आफैँलाई काट्न सक्दैन। `सहनशक्ति = 0` को अर्थ त्यो कहिल्यै भागेन —
// त्यही समुच्चय हो, भरिएर कोरिएको।
//
//   >>|  पर्दा खोल्छ   >>!  मेटाउँछ   >>?  नाप्छ
//   >>~  एउटा खोपी लेख्छ, एउटा पङ्क्तिमा, एउटा स्तम्भमा, एउटा रङमा
//   <<|  एउटा कुञ्जीको पर्खाइ गर्छ
//
// दुई बचत, र दुवै नापमा होइन चित्रमै देखिन्छन्: वर्गहरू एक पाइलाबाट
// अर्कोसम्म बोकिन्छन्, फेरि गनिँदैनन्; अनि समुच्चय वास्तविक अक्षको
// वरिपरि ऐनाजस्तै पर्छ, त्यसैले माथिल्लो आधा मात्र भाग्छ। दुवै मिलेर
// विवरणले माग्ने त्यो स्पष्टता किन्छन्।
// ============================================================

// समुच्चयबाहिर: धमिलोबाट भरिएसम्म, गाढा हरियोबाट चम्किलोसम्म।
ढलान  = " .:-=+*#%"
रङहरू = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// कक्ष भाग्नुअघि थामिएका पाइला; कहिल्यै नभागे ०।
// कक्ष_वास्तविक2 र कक्ष_काल्पनिक2 बोकिन्छन्, त्यसैले हरेक पाइलाले चार गुणन माग्छ, छ होइन।
भागाइ(बिन्दु_वास्तविक, बिन्दु_काल्पनिक) {
    कक्ष_वास्तविक  = 0.0
    कक्ष_काल्पनिक  = 0.0
    कक्ष_वास्तविक2 = 0.0
    कक्ष_काल्पनिक2 = 0.0
    @ फन्को:1..36 {
        ? कक्ष_वास्तविक2 + कक्ष_काल्पनिक2 > 4.0 { <~ फन्को }
        कक्ष_काल्पनिक  = 2.0 * कक्ष_वास्तविक * कक्ष_काल्पनिक + बिन्दु_काल्पनिक
        कक्ष_वास्तविक  = कक्ष_वास्तविक2 - कक्ष_काल्पनिक2 + बिन्दु_वास्तविक
        कक्ष_वास्तविक2 = कक्ष_वास्तविक * कक्ष_वास्तविक
        कक्ष_काल्पनिक2 = कक्ष_काल्पनिक * कक्ष_काल्पनिक
    }
    <~ 0
}

>>| {
    >>!
    (अग्लो, चौडा) = >>?
    पङ्क्तिहरू = अग्लो - 2
    स्तम्भ     = चौडा  - 1

    // एउटा खोपी आफ्नो चौडाइभन्दा करिब २.५ गुणा अग्लो छ; ठाडो
    // फैलावट त्यसैले नापिन्छ, ताकि समुच्चय गोलो निस्कोस्।
    चौडाइ = 2.7
    उचाइ  = पङ्क्तिहरू * चौडाइ * 2.5 / स्तम्भ
    बीच   = पङ्क्तिहरू / 2 + 1

    @ पङ्क्तिक्रम:1..बीच {
        ऐना = पङ्क्तिहरू + 1 - पङ्क्तिक्रम
        @ स्तम्भक्रम:1..स्तम्भ {
            बिन्दु_वास्तविक = (स्तम्भक्रम  - 1) * चौडाइ / स्तम्भ     - 2.1
            बिन्दु_काल्पनिक = (पङ्क्तिक्रम - 1) * उचाइ  / पङ्क्तिहरू - उचाइ / 2.0
            सहनशक्ति       = भागाइ(बिन्दु_वास्तविक, बिन्दु_काल्पनिक)
            चिन्ह          = "@"
            रङ            = 231
            ? सहनशक्ति <> 0 {
                पाइला = सहनशक्ति / 4 + 1
                ? पाइला > 9 { पाइला = 9 }
                चिन्ह = ढलान[पाइला]
                रङ   = रङहरू[पाइला]
            }
            >>~ (पङ्क्तिक्रम, स्तम्भक्रम, 0, रङ) > चिन्ह
            ? ऐना > बीच { >>~ (ऐना, स्तम्भक्रम, 0, रङ) > चिन्ह }
        }
    }

    >>~ (अग्लो, 2, 0, 244) > "बाहिर निस्कन कुनै पनि कुञ्जी थिच्नुहोस्"
    <<| _कुञ्जी
}
