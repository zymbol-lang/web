// @skip-parity: തിരശ്ശീലയ്ക്ക് CLI-യുടെ കീഴിൽ യഥാർത്ഥ ടെർമിനലും ബ്രൗസറിൽ ഒരു
// @skip-parity: തിരശ്ശീലപ്പാളിയും വേണം; അതിനാൽ കുഴലിലൂടെ ഓടിച്ചാൽ താരതമ്യത്തിന് ഒന്നുമില്ല.
// ============================================================
// mandelbrot — മാൻഡൽബ്രോട്ട് ഗണം, ടെർമിനലിന്റെ തിരശ്ശീലയിൽ വരച്ചത്.
// പേരുകൾ മലയാളത്തിൽ. അടയാളങ്ങൾ എപ്പോഴും അടയാളങ്ങൾ തന്നെ.
//
// എല്ലാം തീരുമാനിക്കുന്നത് ഒരൊറ്റ സംഖ്യയാണ്: `n`, ഭ്രമണപഥം
// രക്ഷപ്പെടും മുൻപ് എത്ര ചുവടുകൾ താങ്ങുന്നു. അതുതന്നെ അക്ഷരം
// തിരഞ്ഞെടുക്കുന്നു, അതുതന്നെ നിറവും തിരഞ്ഞെടുക്കുന്നു; അതിനാൽ ചിത്രം
// തന്നോടുതന്നെ വിരുദ്ധമാകാനാവില്ല. `n = 0` എന്നാൽ അത് ഒരിക്കലും
// രക്ഷപ്പെട്ടില്ല — അതുതന്നെ ഗണം, നിറച്ചു വരച്ചത്.
//
//   >>|  തിരശ്ശീല തുറക്കുന്നു   >>!  മായ്ക്കുന്നു   >>?  അളക്കുന്നു
//   >>~  ഒരു കളം എഴുതുന്നു, ഒരു വരിയിൽ, ഒരു നിരയിൽ, ഒരു നിറത്തിൽ
//   <<|  ഒരു കീയ്ക്കായി കാത്തിരിക്കുന്നു
//
// രണ്ടു ലാഭം, രണ്ടും അളവിലല്ല ചിത്രത്തിൽത്തന്നെ കാണാം: വർഗ്ഗങ്ങൾ ഒരു
// ചുവടിൽനിന്ന് അടുത്തതിലേക്കു കൊണ്ടുപോകുന്നു, വീണ്ടും കണക്കാക്കുന്നില്ല;
// ഗണം യഥാർത്ഥ അക്ഷത്തിനു ചുറ്റും കണ്ണാടിപോലെ വീഴുന്നു, അതിനാൽ മേൽപ്പകുതി
// മാത്രമേ രക്ഷപ്പെടുന്നുള്ളൂ. രണ്ടും ചേർന്ന് വിശദാംശം ചോദിക്കുന്ന
// തെളിച്ചത്തിന് വില കൊടുക്കുന്നു.
// ============================================================

// ഗണത്തിനു പുറത്ത്: മങ്ങിയതിൽനിന്ന് നിറഞ്ഞതിലേക്ക്, കടും പച്ചയിൽനിന്ന് തിളക്കത്തിലേക്ക്.
ചരിവ്    = " .:-=+*#%"
നിറങ്ങൾ = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// ഭ്രമണപഥം രക്ഷപ്പെടും മുൻപ് താങ്ങിയ ചുവടുകൾ; ഒരിക്കലും രക്ഷപ്പെട്ടില്ലെങ്കിൽ ൦.
// zr2, zi2 എന്നിവ കൊണ്ടുപോകുന്നു, അതിനാൽ ഓരോ ചുവടിനും നാലു ഗുണനം, ആറല്ല.
രക്ഷപ്പെടൽ(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (ഉയരം, വീതി) = >>?
    വരികൾ = ഉയരം - 2
    നിരകൾ = വീതി  - 1

    // ഒരു കളം അതിന്റെ വീതിയേക്കാൾ ഏകദേശം ൨.൫ മടങ്ങ് ഉയരമുള്ളതാണ്;
    // ലംബമായ വ്യാപ്തി അതുകൊണ്ട് അളക്കുന്നു, ഗണം ഉരുണ്ടു വരാൻ.
    വീതിവ്യാപ്തി = 2.7
    ഉയരവ്യാപ്തി  = വരികൾ * വീതിവ്യാപ്തി * 2.5 / നിരകൾ
    നടു           = വരികൾ / 2 + 1

    @ y:1..നടു {
        കണ്ണാടി = വരികൾ + 1 - y
        @ x:1..നിരകൾ {
            cr = (x - 1) * വീതിവ്യാപ്തി / നിരകൾ - 2.1
            ci = (y - 1) * ഉയരവ്യാപ്തി  / വരികൾ - ഉയരവ്യാപ്തി / 2.0
            n  = രക്ഷപ്പെടൽ(cr, ci)
            അടയാളം = "@"
            നിറം    = 231
            ? n <> 0 {
                ചുവട് = n / 4 + 1
                ? ചുവട് > 9 { ചുവട് = 9 }
                അടയാളം = ചരിവ്[ചുവട്]
                നിറം    = നിറങ്ങൾ[ചുവട്]
            }
            >>~ (y, x, 0, നിറം) > അടയാളം
            ? കണ്ണാടി > നടു { >>~ (കണ്ണാടി, x, 0, നിറം) > അടയാളം }
        }
    }

    >>~ (ഉയരം, 2, 0, 244) > "പുറത്തുകടക്കാൻ ഏതെങ്കിലും കീ അമർത്തുക"
    <<| _കീ
}
