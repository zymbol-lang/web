// @skip-parity: платното иска истински терминал под CLI и слой платно в
// @skip-parity: браузъра, тъй че пускане през тръба няма с какво да се сравни.
// ============================================================
// mandelbrot — множеството на Манделброт, начертано върху платното.
// Имена на български. Знаците винаги остават знаци.
//
// Всичко решава едно число: `n`, колко стъпки орбитата издържа,
// преди да избяга. То избира знака и то избира цвета, тъй че
// рисунката не може да си противоречи. `n = 0` значи, че тя не е
// избягала никога — това е множеството, начертано плътно.
//
//   >>|  отваря платното   >>!  чисти го   >>?  мери го
//   >>~  пише една клетка, на ред, в колона, с един цвят
//   <<|  чака клавиш
//
// Две икономии, и двете се виждат в рисунката, а не в измерване:
// квадратите се пренасят от стъпка на стъпка, вместо да се
// пресмятат наново, а множеството се огледалва спрямо реалната
// ос, тъй че бяга само горната половина. Заедно плащат онази
// разделителност, която подробността иска.
// ============================================================

// Извън множеството: от бледо до плътно, от тъмнозелено до ярко.
скала   = " .:-=+*#%"
цветове = [22, 28, 34, 40, 46, 82, 118, 154, 191]

// Стъпки, издържани преди орбитата да избяга; 0, ако не бяга никога.
// zr2 и zi2 се пренасят, тъй че всяка стъпка струва четири умножения, а не шест.
бягство(cr, ci) {
    zr  = 0.0
    zi  = 0.0
    zr2 = 0.0
    zi2 = 0.0
    @ i:1..36 {
        ? zr2 + zi2 > 4.0 { <~ i }
        zi  = 2.0 * zr * zi + ci
        zr  = zr2 - zi2 + cr
        zr2 = zr * zr
        zi2 = zi * zi
    }
    <~ 0
}

>>| {
    >>!
    (високо, широко) = >>?
    редове = високо - 2
    колони = широко - 1

    // Клетката е около 2,5 пъти по-висока, отколкото широка;
    // отвесният обхват се мащабира с това, за да излезе кръгло.
    ширина   = 2.7
    височина = редове * ширина * 2.5 / колони
    среда    = редове / 2 + 1

    @ y:1..среда {
        огледало = редове + 1 - y
        @ x:1..колони {
            cr = (x - 1) * ширина   / колони - 2.1
            ci = (y - 1) * височина / редове - височина / 2.0
            n  = бягство(cr, ci)
            знак = "@"
            цвят = 231
            ? n <> 0 {
                стъпка = n / 4 + 1
                ? стъпка > 9 { стъпка = 9 }
                знак = скала[стъпка]
                цвят = цветове[стъпка]
            }
            >>~ (y, x, 0, цвят) > знак
            ? огледало > среда { >>~ (огледало, x, 0, цвят) > знак }
        }
    }

    >>~ (високо, 2, 0, 244) > "който и да е клавиш за изход"
    <<| _клавиш
}
