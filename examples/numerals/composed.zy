// Numerals: a mode reaches composed text, not only `>>`
//
// An active numeral mode applies wherever a number becomes text: bare output,
// interpolation, juxtaposition, $++ — and the elements inside arrays and
// tuples, because a number does not stop being a number by sitting in a list.
// A number folded into a string used to fall back to ASCII, so a translated
// label could show its digits in the wrong script while the same value printed
// correctly on its own.
//
// The counterpart is that the digits come back: `#.N|` and `#!N|` read a number
// written in any script, so a value this program renders it can also re-read.

n = 120
a = [1, 2, 3]

>> "ASCII, no mode active:" ¶
>> "  bare          " n ¶
>> "  interpolation {n}" ¶
>> "  juxtaposition " ("n=" n) ¶
>> "  concat build  " ("n=" $++ n) ¶
>> "  array         " a ¶

#०९#

>> "" ¶
>> "Devanagari mode active:" ¶
>> "  bare          " n ¶
>> "  interpolation {n}" ¶
>> "  juxtaposition " ("n=" n) ¶
>> "  concat build  " ("n=" $++ n) ¶
>> "  array         " a ¶

// The round trip: render, then read the rendered digits back as a number.
s = "{n}"
>> "  re-read       " #.0|s| ¶

#09#

>> "" ¶
>> "back to ASCII:  " n ¶
